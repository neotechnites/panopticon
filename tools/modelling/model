#!/usr/bin/env bash
#
# model -- the PANOPTICON 3D modelling pipeline, driven from the Mac.
#
#   Author on the Mac.  Build where Blender is.  Look at it on the Mac.
#
# THE FAST LOOP -- write, build, one preview, look, iterate:
#
#   tools/modelling/model build bush --preview   # glb + 3 quarter-res views, seconds
#
# THE FINAL PASS -- the full sheet, the contract, the gate:
#
#   tools/modelling/model build bush             # full view sheet, verified, installed
#   tools/modelling/model build bush --prop      # ...and run the gate the model has earned
#   tools/modelling/model parity bush            # do the Mac's bytes match the PC's?
#
# Everything else:
#
#   tools/modelling/model build runner --views front,side,threequarter,hero
#   tools/modelling/model build runner --cam 200,35 --cam 15,-10,35 --res 1400x1400
#   tools/modelling/model build runner --frame 6 --turntable 8
#   tools/modelling/model build runner --variant slab       # a variant of one build script
#   tools/modelling/model look   runner --cam 120,25        # renders only, no install
#   tools/modelling/model look   runner --rest              # rest pose, to debug a rig
#   tools/modelling/model verify runner                     # re-check the shipped .glb
#   tools/modelling/model refs   runner                     # which scenes use it
#   tools/modelling/model audit  runner                     # contiguity + quality only
#   tools/modelling/model views                             # list the named views
#   tools/modelling/model open                              # reveal the renders in Finder
#
# WHERE IT BUILDS. Blender on this Mac is the default the moment it is
# installed (brew install --cask blender -- keep it on the same Blender series
# the PC runs). --pc forces the Windows box; the PC is also the automatic
# fallback when there is no Mac Blender. Same script, same spec, same bytes.
#
# See docs/MODELLING.md. The short version of what bit us:
#   * EEVEE cannot run over plain ssh. On the PC it goes through a scheduled
#     task created /it so that it lands in the logged-on console session and
#     finds the GPU. On the Mac it just runs.
#   * Never run Godot WINDOWED on the Mac; it steals the keyboard. Headless is
#     what the suite already does, and it is what verifies a locally built model.
#   * A handful of build scripts branch on floating-point comparisons and do
#     not produce identical bytes on arm64 and x86-64. `model parity <name>`
#     is how you find out, and it is why the PC stays one flag away.
#
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
HERE="$REPO/tools/modelling"

PC_ALIAS="panopticon-pc"
PC_SCP="ddd@100.114.41.16"
PC_KEY="$HOME/.ssh/panopticon_pc_ed25519"
PC_WORK='C:/Users/ddd/panopticon-modelling'
PC_WORK_W='C:\Users\ddd\panopticon-modelling'
# Every model gets its own job directory, its own copy of the library and its
# own scheduled-task name. Several agents share this repo and this PC, and a
# single shared build.log / build.done / task name means one agent's run
# silently eats another's -- which presents as "blender failed" on a script
# that is perfectly fine.
# Named PC_* so that the Mac's own GODOT / MODEL_BLENDER environment overrides
# cannot be shadowed by the Windows paths -- they were, once, and it presented
# as "godot verification FAILED" with an empty log.
PC_BLENDER='C:\tools\blender\blender.exe'
PC_GODOT='C:\tools\godot\godot.exe'

MODELS="$REPO/assets/models"
RENDERS="$HOME/Desktop/panopticon-renders"

# The Mac toolchain. MODEL_BLENDER / GODOT override it; otherwise the cask's
# app bundle, then anything on PATH. An empty MAC_BLENDER is not an error -- it
# just means every build goes to the PC, exactly as it always did.
MAC_BLENDER="${MODEL_BLENDER:-}"
if [ -z "$MAC_BLENDER" ]; then
  for c in /Applications/Blender.app/Contents/MacOS/Blender "$(command -v blender || true)"; do
    if [ -n "$c" ] && [ -x "$c" ]; then MAC_BLENDER="$c"; break; fi
  done
fi
MAC_GODOT="${GODOT:-$(command -v godot || true)}"

die() { printf 'model: %s\n' "$*" >&2; exit 1; }
say() { printf '\033[1m==> %s\033[0m\n' "$*"; }

pc()      { ssh -o ConnectTimeout=20 "$PC_ALIAS" "$@"; }
push()    { scp -q -i "$PC_KEY" "$1" "$PC_SCP:$2"; }
pull()    { scp -q -i "$PC_KEY" "$PC_SCP:$1" "$2"; }

# -----------------------------------------------------------------------------
# argument parsing
# -----------------------------------------------------------------------------
CMD="${1:-help}"; shift || true

VIEWS=""
CAMS=()
RES=""
ENGINE="eevee"
SAMPLES=""
FRAME=""
TURNTABLE=0
VARIANT=""
MARGIN=""
DO_VERIFY=1
DO_INSTALL=1
DO_GLB=1
KEEP=0
TIMEOUT=900
REST=0
LIGHT=""
VARIANT=""
# These three were lost in a merge. Under `set -u` that presents as
# `PREVIEW: unbound variable` / `WHERE: unbound variable` and every build that is
# not --preview dies before it starts. Kept together so the next merge sees them.
PREVIEW=0
PROP=0
WHERE=""            # "" = decide, "local" = this Mac, "pc" = the Windows box

while [ $# -gt 0 ]; do
  case "$1" in
    --views)      VIEWS="$2"; shift 2 ;;
    --cam)        CAMS+=("$2"); shift 2 ;;
    --res)        RES="$2"; shift 2 ;;
    --engine)     ENGINE="$2"; shift 2 ;;
    --cpu)        ENGINE="cycles"; shift ;;
    --rest)       REST=1; shift ;;
    --light)      LIGHT="$2"; shift 2 ;;
    --variant)    VARIANT="$2"; shift 2 ;;
    --gpu)        ENGINE="eevee"; shift ;;
    --preview)    PREVIEW=1; shift ;;
    --prop)       PROP=1; shift ;;
    --local)      WHERE="local"; shift ;;
    --pc)         WHERE="pc"; shift ;;
    --samples)    SAMPLES="$2"; shift 2 ;;
    --frame)      FRAME="$2"; shift 2 ;;
    --turntable)  TURNTABLE="$2"; shift 2 ;;
    --variant)    VARIANT="$2"; shift 2 ;;
    --margin)     MARGIN="$2"; shift 2 ;;
    --timeout)    TIMEOUT="$2"; shift 2 ;;
    --no-verify)  DO_VERIFY=0; shift ;;
    --no-install) DO_INSTALL=0; shift ;;
    --keep)       KEEP=1; shift ;;
    -h|--help)    CMD=help; shift ;;
    -*)           die "unknown option $1" ;;
    *)            NAME="${NAME:-$1}"; shift ;;
  esac
done
NAME="${NAME:-}"
# One build script, many models: the variant rides every per-job name so two
# variants never share a job directory, a task name or an installed .glb.
case "$VARIANT" in
  "")           FULL="$NAME" ;;
  *[!a-z0-9_]*) die "--variant must be [a-z0-9_]+" ;;
  *)            FULL="${NAME}_${VARIANT}" ;;
esac

JOB="$PC_WORK/jobs/$FULL"
JOB_W="$PC_WORK_W\\jobs\\$FULL"
TASK="PanopticonModelling_${FULL:-none}"

# -----------------------------------------------------------------------------
# helpers
# -----------------------------------------------------------------------------

json_spec() {
  # $1 = out_dir on the PC (windows path, forward slashes)
  python3 - "$1" <<PY
import json, sys
spec = {
    "engine": "$ENGINE",
    "out_dir": sys.argv[1],
    "glb": bool($DO_GLB),
    "turntable": int("$TURNTABLE"),
}
if "$VARIANT":
    spec["variant"] = "$VARIANT"
views = "$VIEWS"
if views:
    spec["views"] = [v.strip() for v in views.split(",") if v.strip()]
elif "${#CAMS[@]}" != "0" or int("$TURNTABLE"):
    spec["views"] = []
cams = """$(printf '%s\n' "${CAMS[@]+"${CAMS[@]}"}")""".split()
if cams:
    spec["cams"] = [[float(x) for x in c.split(",")] for c in cams if c]
res = "$RES"
if res:
    w, h = res.lower().split("x")
    spec["resolution"] = [int(w), int(h)]
if "$SAMPLES":
    spec["samples"] = int("$SAMPLES")
if "$MARGIN":
    spec["margin"] = float("$MARGIN")
if "$FRAME" != "":
    spec["frame"] = int("$FRAME")
if "$REST" == "1":
    spec["pose"] = "rest"
if "$LIGHT":
    spec["key_energy"] = float("$LIGHT")
if "$PREVIEW" == "1":
    # mdl fills in the view list, the quarter resolution, the sample count and
    # the scale proxy. Anything named on the command line still wins.
    spec["preview"] = True
print(json.dumps(spec, indent=1))
PY
}

ensure_workdir() {
  pc "New-Item -ItemType Directory -Force -Path '$JOB_W','$JOB_W\\out','$JOB_W\\verify' | Out-Null; 'ready'" >/dev/null
}

# Runs a batch file on the PC. $1 = basename (no .bat), $2 = "interactive"|"direct"
run_bat() {
  local stem="$1" mode="$2" flag=""
  [ "$mode" = "direct" ] && flag="-Direct"
  pc "powershell -NoProfile -ExecutionPolicy Bypass -File '$JOB_W\\pcrun.ps1' -Bat '$JOB_W\\$stem.bat' -TaskName '$TASK' -TimeoutSec $TIMEOUT $flag"
}

# -----------------------------------------------------------------------------
# stages
# -----------------------------------------------------------------------------

stage_ship() {
  local script="$HERE/${NAME}_build.py"
  [ -f "$script" ] || die "no build script at tools/modelling/${NAME}_build.py
       Author one first -- that file IS the model. A model whose script lives
       in a scratchpad is a model you cannot change (see docs/MODELLING.md)."
  ensure_workdir
  # Clear this model's previous output, or stage_fetch drags back renders from
  # a view set you are no longer asking for and you compare against a stale png.
  # -Path, not -LiteralPath: LiteralPath treats the * as part of the filename
  # and silently deletes nothing, which is exactly the stale-render trap.
  pc "Remove-Item -Path '$JOB_W\\out\\${FULL}_*.png' -ErrorAction SilentlyContinue" >/dev/null
  push "$HERE/lib/mdl.py"        "$JOB/mdl.py"
  push "$HERE/lib/pcrun.ps1"     "$JOB/pcrun.ps1"
  push "$script"                 "$JOB/${NAME}_build.py"
  # Sibling build scripts the script imports (tower_hollow reads tower_arches
  # and tower_interior; hub_base's wedge themes read marble and forest_tree),
  # and what those import in turn; they ride along or the import fails on the PC.
  local queue="$NAME" seen=" $NAME " dep
  while [ -n "$queue" ]; do
    local cur="${queue%% *}"
    queue="${queue#"$cur"}"; queue="${queue# }"
    for dep in $(grep -oE '^(import|from) [a-z0-9_]+_build( |$)' "$HERE/${cur}_build.py" | awk '{print $2}'); do
      dep="${dep%_build}"
      case "$seen" in *" $dep "*) continue ;; esac
      seen="$seen$dep "
      queue="${queue:+$queue }$dep"
      push "$HERE/${dep}_build.py" "$JOB/${dep}_build.py"
    done
    # Shared modules under lib/ that the script imports by bare name
    # (a build script may keep a layout or a proof there). mdl.py already
    # lands beside the script, so these go to the same place and the script
    # directory's place on sys.path finds them -- without this a --pc build
    # dies on ImportError while the Mac build is perfectly fine.
    for dep in $(grep -oE '^(import|from) [a-z0-9_]+' "$HERE/${cur}_build.py" | awk '{print $2}'); do
      [ -f "$HERE/lib/${dep}.py" ] || continue
      case "$seen" in *" lib:$dep "*) continue ;; esac
      seen="$seen lib:$dep "
      push "$HERE/lib/${dep}.py" "$JOB/${dep}.py"
    done
  done
  # Texture files a build script may load instead of painting (map_base's
  # river/lava sheets): shipped next to the script, stale ones cleared.
  pc "Remove-Item -Recurse -Force -Path '$JOB_W\\textures' -ErrorAction SilentlyContinue; 'ok'" >/dev/null || true
  if [ -d "$HERE/textures" ]; then
    pc "New-Item -ItemType Directory -Force -Path '$JOB_W\\textures' | Out-Null" >/dev/null
    for f in "$HERE"/textures/*; do
      [ -f "$f" ] && push "$f" "$JOB/textures/$(basename "$f")"
    done
  fi
  json_spec "$JOB/out" > "$TMP/spec.json"
  push "$TMP/spec.json"          "$JOB/spec.json"
}

stage_blender() {
  # Blender exits 0 after a Python traceback in -b -P, so the exit code alone
  # will happily report success for a script that never built anything. The
  # "MDL DONE" marker is written by mdl.main as its last act; require it.
  cat > "$TMP/build.bat" <<EOF
@echo off
set W=$JOB_W
del /q "%W%\\build.done" 2>nul
cd /d "%W%"
"$PC_BLENDER" -b -noaudio -P "%W%\\${NAME}_build.py" -- --spec "%W%\\spec.json"${VARIANT:+ --variant $VARIANT} > "%W%\\build.log" 2>&1
set RC=%ERRORLEVEL%
findstr /c:"MDL DONE" "%W%\\build.log" >nul || set RC=1
echo %RC% > "%W%\\build.done"
EOF
  push "$TMP/build.bat" "$JOB/build.bat"

  local mode="interactive"
  [ "$ENGINE" = "cycles" ] && mode="direct"

  say "blender ($ENGINE, $mode session)"
  local t0 t1
  t0=$(date +%s)
  if ! run_bat build "$mode" > "$TMP/build.out" 2>&1; then
    grep -E 'MDL|Error|EXCEPTION|Traceback|^  File|PCRUN' "$TMP/build.out" | tail -40 >&2 || true
    die "blender failed. Full log: ssh $PC_ALIAS \"type $JOB_W\\build.log\""
  fi
  t1=$(date +%s)
  BLENDER_SECS=$((t1 - t0))
  grep -E '^MDL (STATS|EXPORT|RENDER|DONE|note)' "$TMP/build.out" || true
}

stage_verify() {
  say "godot import check"
  # A fresh scratch project every time. Godot prints an import's complaints
  # exactly once; reusing .godot/ makes the second run of a broken model green.
  cat > "$TMP/project.godot" <<'EOF'
config_version=5

[application]
config/name="modelling-verify"
config/features=PackedStringArray("4.7", "GL Compatibility")

[debug]
gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
EOF
  push "$TMP/project.godot"        "$JOB/verify/project.godot"
  push "$HERE/lib/verify_glb.gd"   "$JOB/verify/verify_glb.gd"
  # A variant may be held to its own contract; if it does not carry one it is
  # still held to the base model's, because a variant is not an excuse.
  local contract="$HERE/${FULL}.contract.json"
  [ -f "$contract" ] || contract="$HERE/${NAME}.contract.json"
  if [ -f "$contract" ]; then
    push "$contract" "$JOB/verify/contract.json"
  else
    pc "Remove-Item -LiteralPath '$JOB_W\\verify\\contract.json' -ErrorAction SilentlyContinue" >/dev/null
  fi

  cat > "$TMP/verify.bat" <<EOF
@echo off
set W=$JOB_W
del /q "%W%\\verify.done" 2>nul
rmdir /s /q "%W%\\verify\\.godot" 2>nul
del /q "%W%\\verify\\*.import" "%W%\\verify\\*.png" 2>nul
copy /y "%W%\\out\\${FULL}.glb" "%W%\\verify\\model.glb" >nul
"$PC_GODOT" --headless --path "%W%\\verify" --import > "%W%\\verify.log" 2>&1
"$PC_GODOT" --headless --path "%W%\\verify" --script res://verify_glb.gd >> "%W%\\verify.log" 2>&1
echo %ERRORLEVEL% > "%W%\\verify.done"
EOF
  push "$TMP/verify.bat" "$JOB/verify.bat"

  if ! run_bat verify direct > "$TMP/verify.out" 2>&1; then
    grep -E 'VERIFY|ERROR|WARNING|PCRUN' "$TMP/verify.out" | tail -40 >&2 || true
    die "godot verification FAILED -- the model was not installed"
  fi

  # Zero errors AND zero warnings is the bar. Godot's importer is happy to
  # warn about a lost skin and still exit 0.
  local bad
  bad=$(grep -cE '^(ERROR|WARNING|SCRIPT ERROR|USER ERROR)' "$TMP/verify.out" || true)
  if [ "${bad:-0}" -gt 0 ]; then
    grep -E '^(ERROR|WARNING|SCRIPT ERROR|USER ERROR)' -A2 "$TMP/verify.out" >&2
    die "$bad error/warning line(s) during import -- the model was not installed"
  fi
  grep -E '^VERIFY' "$TMP/verify.out" || true
}

stage_fetch() {
  mkdir -p "$RENDERS"
  local listing
  listing=$(pc "Get-ChildItem '$JOB_W\\out' -Filter '${FULL}*' | Select-Object -ExpandProperty Name")
  local got=0
  while IFS= read -r f; do
    f="${f%$'\r'}"
    [ -n "$f" ] || continue
    case "$f" in
      *.png)
        pull "$JOB/out/$f" "$RENDERS/$f"
        if [ "$KEEP" = "1" ]; then
          mkdir -p "$RENDERS/archive"
          cp "$RENDERS/$f" "$RENDERS/archive/${f%.png}_$(date +%Y%m%d-%H%M%S).png"
        fi
        got=$((got + 1))
        ;;
      *.glb)
        pull "$JOB/out/$f" "$TMP/$f"
        ;;
      *.stats.json)
        pull "$JOB/out/$f" "$TMP/$f"
        ;;
    esac
  done <<< "$listing"
  say "$got render(s) -> $RENDERS"
}

stage_install() {
  # $GLB_SRC, not a hardcoded fetch path: the LOCAL branch builds into
  # $TMP/out/ and only the PC branch pulls into $TMP/, so reading the PC path
  # made every Mac build die with "no <name>.glb came back from the PC" after
  # it had already built and verified the model.
  [ -n "$GLB_SRC" ] && [ -f "$GLB_SRC" ] || die "no ${FULL}.glb was produced ($GLB_SRC)"
  mkdir -p "$MODELS"
  cp "$GLB_SRC" "$MODELS/${FULL}.glb"
  say "assets/models/${FULL}.glb ($(wc -c < "$MODELS/${FULL}.glb" | tr -d ' ') bytes)"
  "$REPO/tools/fix_glb_imports.sh"
  if [ -f "$MODELS/${FULL}.glb.import" ]; then
    echo "    (${FULL}.glb.import kept -- it carries the uid the scenes reference)"
  fi
}

# -----------------------------------------------------------------------------
# stages -- the local (Mac) backend
#
# Same build script, same spec JSON, same mdl.py. The only thing that changes
# is that nothing is copied anywhere: the script already sits next to its
# textures and its sibling _build modules, so the PC's ship/fetch dance simply
# has no work to do here.
# -----------------------------------------------------------------------------

require_script() {
  [ -f "$HERE/${NAME}_build.py" ] || die "no build script at tools/modelling/${NAME}_build.py
       Author one first -- that file IS the model. A model whose script lives
       in a scratchpad is a model you cannot change (see docs/MODELLING.md)."
}

stage_blender_local() {
  require_script
  mkdir -p "$TMP/out"
  json_spec "$TMP/out" > "$TMP/spec.json"
  say "blender (local, $ENGINE)"
  local t0 t1 rc=0
  t0=$(date +%s)
  ( cd "$HERE" && PYTHONPATH="$HERE:$HERE/lib" \
      "$MAC_BLENDER" -b -noaudio -P "$HERE/${NAME}_build.py" -- --spec "$TMP/spec.json" \
  ) > "$TMP/build.out" 2>&1 || rc=$?
  # Blender exits 0 after a Python traceback under -b -P, so the exit code
  # alone reports success for a script that built nothing. mdl.main writes
  # "MDL DONE" as its last act; that marker is the real verdict.
  grep -q 'MDL DONE' "$TMP/build.out" || rc=1
  if [ "$rc" -ne 0 ]; then
    cp "$TMP/build.out" "$FAILLOG" 2>/dev/null || true
    grep -E 'MDL|Error|EXCEPTION|Traceback|^  File' "$TMP/build.out" | tail -40 >&2 || true
    die "blender failed. Full log: $FAILLOG"
  fi
  t1=$(date +%s)
  BLENDER_SECS=$((t1 - t0))
  grep -E '^MDL (STATS|EXPORT|RENDER|DONE|preview|note)' "$TMP/build.out" || true
}

stage_verify_local() {
  say "godot import check (local, headless)"
  local V="$TMP/verify" rc=0
  rm -rf "$V"; mkdir -p "$V"
  # A fresh scratch project every time: Godot prints an import's complaints
  # exactly once, so a reused .godot/ makes the second run of a broken model
  # green. Headless only -- a windowed Godot on the Mac steals the keyboard.
  cat > "$V/project.godot" <<'EOF'
config_version=5

[application]
config/name="modelling-verify"
config/features=PackedStringArray("4.7", "GL Compatibility")

[debug]
gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
EOF
  cp "$HERE/lib/verify_glb.gd" "$V/verify_glb.gd"
  [ -f "$HERE/${NAME}.contract.json" ] && cp "$HERE/${NAME}.contract.json" "$V/contract.json"
  cp "$GLB_SRC" "$V/model.glb"
  "$MAC_GODOT" --headless --path "$V" --import   > "$TMP/verify.out" 2>&1 || true
  "$MAC_GODOT" --headless --path "$V" --script res://verify_glb.gd >> "$TMP/verify.out" 2>&1 || rc=$?
  if [ "$rc" -ne 0 ]; then
    grep -E 'VERIFY|ERROR|WARNING' "$TMP/verify.out" | tail -40 >&2 || true
    die "godot verification FAILED -- the model was not installed"
  fi
  # Zero errors AND zero warnings is the bar. Godot's importer is happy to warn
  # about a lost skin and still exit 0.
  local bad
  bad=$(grep -cE '^(ERROR|WARNING|SCRIPT ERROR|USER ERROR)' "$TMP/verify.out" || true)
  if [ "${bad:-0}" -gt 0 ]; then
    grep -E '^(ERROR|WARNING|SCRIPT ERROR|USER ERROR)' -A2 "$TMP/verify.out" >&2
    die "$bad error/warning line(s) during import -- the model was not installed"
  fi
  grep -E '^VERIFY' "$TMP/verify.out" || true
}

stage_fetch_local() {
  mkdir -p "$RENDERS"
  local got=0 f
  for f in "$TMP"/out/"$NAME"_*.png; do
    [ -f "$f" ] || continue
    cp "$f" "$RENDERS/$(basename "$f")"
    if [ "$KEEP" = "1" ]; then
      mkdir -p "$RENDERS/archive"
      cp "$f" "$RENDERS/archive/$(basename "${f%.png}")_$(date +%Y%m%d-%H%M%S).png"
    fi
    got=$((got + 1))
  done
  say "$got render(s) -> $RENDERS"
}

# -----------------------------------------------------------------------------
# the gate a model has earned
#
# Not a judgement call. lib/scene_refs.sh greps the scenes, the scripts and the
# resources for the model's path AND for the uid its .import file carries, and
# that answer picks the gate:
#
#   nothing references it  ->  contract + contiguity/quality audit + Godot
#                              import check. tools/test.sh cannot observe a
#                              .glb no scene loads, so running it proves
#                              nothing and costs two minutes.
#   a scene references it  ->  the full gate, every time, no flag to skip it.
# -----------------------------------------------------------------------------

stage_gate() {
  local refs=""
  if refs="$("$HERE/lib/scene_refs.sh" "$NAME")"; then
    say "$NAME is referenced -- the full gate is mandatory"
    printf '    %s\n' $refs
    stage_audit
    # A model a scene actually loads is the one place a silent arm64/x86-64
    # geometry difference would ship, and twenty seconds is nothing against the
    # three minutes this branch is about to spend anyway.
    if [ "$WHERE" = "local" ] && [ -n "$MAC_BLENDER" ]; then
      say "parity against the PC"
      PC_SHA=""
      if stage_ship >/dev/null 2>&1 && NORENDER=1 stage_blender >/dev/null 2>&1 \
         && pull "$JOB/out/${NAME}.glb" "$TMP/pc.glb" 2>/dev/null; then
        PC_SHA=$(shasum -a 256 "$TMP/pc.glb" | cut -d" " -f1)
        MY_SHA=$(shasum -a 256 "$MODELS/${NAME}.glb" | cut -d" " -f1)
        if [ "$PC_SHA" = "$MY_SHA" ]; then
          echo "    identical on both boxes"
        else
          python3 "$HERE/lib/glb_diff.py" "$MODELS/${NAME}.glb" "$TMP/pc.glb" || true
          die "parity BROKEN -- rebuild $NAME with --pc before shipping it"
        fi
      else
        echo "    (PC unreachable -- parity not checked)"
      fi
    fi
    say "bash tools/test.sh"
    bash "$REPO/tools/test.sh" || die "tools/test.sh FAILED -- fix it before you call this done"
    say "bot harness (10 matches)"
    "$MAC_GODOT" --headless --path "$REPO" --script res://tools/harness/run_bot_match.gd \
      -- --matches=10 > "$TMP/harness.out" 2>&1 \
      || { tail -30 "$TMP/harness.out" >&2; die "bot harness FAILED"; }
    tail -3 "$TMP/harness.out"
  else
    say "$NAME is referenced by no scene -- prop gate (audit only, no suite)"
    stage_audit
    echo "    tools/test.sh and the bot harness are SKIPPED on purpose: nothing"
    echo "    loads this model yet. They become mandatory the moment a scene does."
  fi
}

stage_audit() {
  local args=()
  if [ -f "$HERE/${NAME}.contract.json" ]; then
    local mt
    mt=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("max_tris",""))' \
         "$HERE/${NAME}.contract.json")
    [ -n "$mt" ] && args+=(--max-tris "$mt")
  fi
  python3 "$HERE/lib/glb_audit.py" "$MODELS/${NAME}.glb" "${args[@]+"${args[@]}"}" \
    || die "contiguity/quality audit FAILED"
}

# -----------------------------------------------------------------------------
# commands
# -----------------------------------------------------------------------------

TMP="$(mktemp -d "${TMPDIR:-/tmp}/panopticon-model.XXXXXX")"
# MODEL_KEEP_TMP=1 keeps the whole job directory -- spec, logs, scratch Godot
# project -- for when the failure is in the pipeline rather than in the model.
[ "${MODEL_KEEP_TMP:-0}" = "1" ] || trap 'rm -rf "$TMP"' EXIT
# $TMP dies with the run, so a failing build copies its log somewhere the next
# command can still read it.
FAILLOG="${TMPDIR:-/tmp}/panopticon-model-${NAME:-none}.log"
GLB_SRC=""

# Which box builds this. --pc and --local are explicit; otherwise the Mac when
# Blender is installed here, the PC when it is not.
pick_backend() {
  # Ryan 2026-09-23: Blender never runs on the Mac. Every build goes to the PC.
  [ "$WHERE" = "local" ] && die "--local refused: Blender never runs on the Mac (Ryan, 2026-09-23)."
  WHERE="pc"
}

case "$CMD" in

  build|look)
    [ -n "$NAME" ] || die "usage: model $CMD <name> [options]"
    if [ "$CMD" = "look" ]; then DO_INSTALL=0; DO_VERIFY=0; fi
    # A preview is a look, not a delivery: it renders at a quarter of the
    # resolution with a scale proxy standing next to the model, which is not a
    # thing you verify against a contract or install over the shipped .glb.
    if [ "$PREVIEW" = "1" ] && [ "$CMD" = "build" ]; then DO_VERIFY=0; DO_INSTALL=0; fi
    pick_backend
    START=$(date +%s)
    if [ "$WHERE" = "local" ]; then
      stage_blender_local
      GLB_SRC="$TMP/out/${NAME}.glb"
      if [ "$DO_VERIFY" = "1" ]; then stage_verify_local; fi
      stage_fetch_local
    else
      stage_ship
      stage_blender
      if [ "$DO_VERIFY" = "1" ]; then stage_verify; fi
      stage_fetch
      GLB_SRC="$TMP/${NAME}.glb"
    fi
    if [ "$DO_INSTALL" = "1" ]; then stage_install; fi
    say "$CMD $NAME complete in $(( $(date +%s) - START ))s on ${WHERE} (blender ${BLENDER_SECS}s)"
    if [ "$PROP" = "1" ]; then
      [ "$DO_INSTALL" = "1" ] || die "--prop gates the INSTALLED model; drop --preview/--no-install"
      stage_gate
    fi
    ;;

  refs)
    [ -n "$NAME" ] || die "usage: model refs <name>"
    if out="$("$HERE/lib/scene_refs.sh" "$NAME")"; then
      say "$NAME is referenced -- the full gate applies"
      printf '    %s\n' $out
    else
      say "$NAME is referenced by no scene -- the prop gate applies"
    fi
    ;;

  audit)
    [ -n "$NAME" ] || die "usage: model audit <name>"
    [ -f "$MODELS/${NAME}.glb" ] || die "no assets/models/${NAME}.glb"
    stage_audit
    ;;

  gate)
    [ -n "$NAME" ] || die "usage: model gate <name>"
    [ -f "$MODELS/${NAME}.glb" ] || die "no assets/models/${NAME}.glb"
    stage_gate
    ;;

  parity)
    # Two builds of one script, one on each box, compared byte for byte. A few
    # build scripts branch on a floating-point comparison, and arm64 and x86-64
    # do not always land on the same side of one; when that happens the models
    # differ in real geometry and only this says so.
    [ -n "$NAME" ] || die "usage: model parity <name>"
    [ -n "$MAC_BLENDER" ] || die "no Blender on this Mac -- nothing to compare"
    DO_GLB=1; NORENDER=1
    mkdir -p "$TMP/out"
    say "local build"
    stage_blender_local
    cp "$TMP/out/${NAME}.glb" "$TMP/local.glb"
    say "pc build"
    stage_ship
    stage_blender
    pull "$JOB/out/${NAME}.glb" "$TMP/pc.glb"
    A=$(shasum -a 256 "$TMP/local.glb" | cut -d" " -f1)
    B=$(shasum -a 256 "$TMP/pc.glb" | cut -d" " -f1)
    echo "    mac $A"
    echo "    pc  $B"
    if [ "$A" = "$B" ]; then
      say "parity OK -- $NAME builds identically on both boxes"
    else
      python3 "$HERE/lib/glb_diff.py" "$TMP/local.glb" "$TMP/pc.glb" || true
      die "parity BROKEN -- build $NAME on the PC (--pc) for anything you ship"
    fi
    ;;

  verify)
    [ -n "$NAME" ] || die "usage: model verify <name>"
    [ -f "$MODELS/${FULL}.glb" ] || die "no assets/models/${FULL}.glb"
    ensure_workdir
    push "$HERE/lib/pcrun.ps1" "$JOB/pcrun.ps1"
    push "$MODELS/${FULL}.glb" "$JOB/out/${FULL}.glb"
    stage_verify
    ;;

  views)
    python3 - <<PY
import re, sys
src = open("$HERE/lib/mdl.py").read()
block = re.search(r"^VIEWS = \{(.*?)^\}", src, re.S | re.M).group(1)
print("named views (azimuth, elevation, lens mm) -- azimuth is measured from")
print("the model's own front, whichever way the build script authored it:\n")
for line in block.strip().splitlines():
    print("   " + line.strip().rstrip(","))
print("""
   --cam AZ,EL[,LENS]   any angle you like, repeatable
   --turntable N        N shots evenly around the model""")
PY
    ;;

  open)
    open "$RENDERS"
    ;;

  doctor)
    say "mac blender (the default backend)"
    if [ -n "$MAC_BLENDER" ]; then
      echo "    $MAC_BLENDER"
      "$MAC_BLENDER" -v 2>/dev/null | head -1
    else
      echo "    NOT INSTALLED -- every build goes to the PC."
      echo "    brew install --cask blender     # must match the PC's version below"
    fi
    say "mac godot (headless verification)"
    if [ -n "$MAC_GODOT" ]; then "$MAC_GODOT" --headless --version; else echo "    none on PATH"; fi
    say "pc reachable?"
    pc "'ok: ' + \$env:COMPUTERNAME" || die "cannot ssh $PC_ALIAS"
    say "console session (EEVEE needs one)"
    pc "query session" || true
    say "blender"
    pc "(Get-Item '$PC_BLENDER').VersionInfo.ProductVersion; (Get-Item '$PC_BLENDER').Length"
    say "godot"
    pc "& '$PC_GODOT' --headless --version"
    ;;

  help|*)
    sed -n "3,27p" "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    ;;
esac
