# Normalise line endings. Without this, CRLF churn rewrites every file each
# time the repo crosses between macOS and Windows.
* text=auto eol=lf

*.gd      text eol=lf
*.tscn    text eol=lf
*.tres    text eol=lf
*.godot   text eol=lf
*.cfg     text eol=lf
*.import  text eol=lf
*.uid     text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.svg     text eol=lf

*.png     binary
*.jpg     binary
*.webp    binary
*.ogg     binary
*.wav     binary
*.mp3     binary
*.glb     binary
*.gltf    binary
*.blend   binary
*.ttf     binary
*.otf     binary
