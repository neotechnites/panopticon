; Engine configuration file.
; Panopticon — framework notes live in the Senate pod, data/plan/.

config_version=5

[application]

config/name="Panopticon"
config/description="A 3D first-person asymmetrical multiplayer game. One player occupies the tower at the centre; the others run the ring."
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
