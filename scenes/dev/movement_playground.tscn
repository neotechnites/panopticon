[node name="Ground" type="CSGBox3D" parent="."]
editor_description = "400 m square. Deliberately far larger than anything on it: a body chaining hops leaves the useful area in a few seconds, and running out of floor mid-measurement reads as a movement bug."
use_collision = true
size = Vector3(400.0, 2.0, 400.0)
material = SubResource("MatGround")
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, -0, 1, 0, -1, 0)

[node name="Straight" type="Node3D" parent="."]
editor_description = "160 m of clear ground running -Z from spawn, which is the direction the player faces on load. Cross-stripes every 20 m and posts every 10 m: the posts are what give speed a texture -- a number alone does not tell you whether 22 m/s looks fast."

