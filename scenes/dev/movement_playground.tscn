[node name="Ramps" type="Node3D" parent="."]
editor_description = "Two slopes, both under the 46 deg walk limit so they are floor and not wall. Sliding down one is where MovementProfile.slide_slope_acceleration is felt: set equal to gravity, a slide down the 30 deg ramp accelerates like a body on a frictionless plane. Each low end is sunk 5 cm so the join with the ground is a step down, never a lip to catch on."

[node name="RampGentle15" type="CSGBox3D" parent="Ramps"]
editor_description = "15 deg, 36 m of run, rising 9.65 m towards -Z."
use_collision = true
size = Vector3(16.00, 1.0, 37.270)
material = SubResource("MatRamp")
