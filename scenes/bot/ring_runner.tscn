[gd_scene load_steps=7 format=3]

[ext_resource type="PackedScene" path="res://scenes/player/player.tscn" id="1_body"]
[ext_resource type="Script" path="res://scripts/player/bot_intent_source.gd" id="2_bot_input"]
[ext_resource type="Script" path="res://scripts/bot/ring_runner.gd" id="3_brain"]
[ext_resource type="Resource" path="res://scenes/bot/default_bot_profile.tres" id="4_bot_profile"]
[ext_resource type="Material" path="res://scenes/bot/runner_body_material.tres" id="5_runner_material"]
[ext_resource type="Resource" path="res://scenes/bot/default_runner_profile.tres" id="6_runner_profile"]

[node name="Player" groups=["prisoners"] node_paths=PackedStringArray("intent_source") instance=ExtResource("1_body")]
editor_description = "A prisoner body driven by AI. Inherits scenes/player/player.tscn on purpose: the bot must run on the same capsule, the same head height and the same MovementProfile a human gets, or bot telemetry stops describing the shipped game. It is in the \"prisoners\" group so TowerShooter has a candidate list to search; membership grants nothing on its own -- the shooter still has to have the body inside its camera frustum and clear on a raycast before it may read where the body is."
intent_source = NodePath("BotInput")

[node name="Camera" parent="Head" index="0"]
current = false

[node name="HumanInput" parent="." index="2"]
capture_mouse_on_ready = false

[node name="BodyMesh" parent="." index="3"]
editor_description = "Moved off the owner-hidden visual layer 2 onto visual layer 3, because a runner is never the local viewpoint and must stay visible to every player camera. Material is the one shared runner_body_material.tres, unshaded orange so the capsule reads against the grey ring boxes at range."
layers = 4
material_override = ExtResource("5_runner_material")

[node name="ZoomInput" parent="." index="5"]
editor_description = "Disabled. ZoomInput is inherited from the player scene and reads the local device, so on a runner it drives that runner's optic from whoever is holding the human's zoom button. Harmless today because a runner camera never renders, but bots take the tower seat by design, and a bot shooter whose zoom is driven by a human's mouse would be a genuinely confusing bug to find later."
process_mode = 4

[node name="BotInput" type="Node" parent="."]
script = ExtResource("2_bot_input")

[node name="Brain" type="Node" parent="." node_paths=PackedStringArray("controller", "input")]
script = ExtResource("3_brain")
controller = NodePath("..")
input = NodePath("../BotInput")
profile = ExtResource("4_bot_profile")
runner_profile = ExtResource("6_runner_profile")
