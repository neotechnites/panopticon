[node name="CaptureOverlay" type="PanelContainer" parent="."]
visible = false
mouse_filter = 0
editor_description = "Raised while a capture is armed. mouse_filter STOP so a click that misses the panel's own _input still cannot reach the button underneath -- which, since the player just clicked a rebind slot, would be the row they were editing."

[node name="CaptureLabel" type="Label" parent="CaptureOverlay"]
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3
