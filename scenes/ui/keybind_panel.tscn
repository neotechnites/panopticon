[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/keybind_panel.gd" id="1_keybind_panel"]

[node name="KeybindPanel" type="MarginContainer"]
editor_description = "The rebinding table. A MarginContainer rather than a bare Control so its minimum size propagates: the settings panel can then reserve room for the table instead of crushing it, and the overlay still covers the whole panel because a MarginContainer lays every child out to fill its rect."
script = ExtResource("1_keybind_panel")

[node name="Layout" type="VBoxContainer" parent="."]
theme_override_constants/separation = 8

[node name="Hint" type="Label" parent="Layout"]
autowrap_mode = 3
text = "Two bindings per action. Escape cancels a rebind, Backspace clears the slot."

[node name="Scroll" type="ScrollContainer" parent="Layout"]
custom_minimum_size = Vector2(0, 336)
size_flags_vertical = 3
horizontal_scroll_mode = 0
editor_description = "Horizontal scrolling is off because the table is built to fit the panel width; only a long list needs to scroll, and only downwards. The minimum height is what asks the dialog for enough room to show all nine rows at the shipped theme, so the list does not arrive already scrolled by one row. Nothing lines up because of this number -- the grid owns the columns -- so a larger font simply scrolls instead of breaking the table."

[node name="Table" type="GridContainer" parent="Layout/Scroll"]
size_flags_horizontal = 3
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 4
columns = 4
editor_description = "One GridContainer, not nine HBoxContainers. A grid shares its column widths across every row, so the name, the two slots and Reset stay in line whatever the bindings are called and whatever the theme font measures. Nine authored rows in the order the player reads them -- movement, then jump/sprint/crouch, then fire/aim -- which is also what stops Godot's own ui_* actions from ever appearing here."

[node name="MoveForwardName" type="Label" parent="Layout/Scroll/Table"]
size_flags_horizontal = 3
size_flags_vertical = 1
vertical_alignment = 1
text = "Move Forward"

[node name="MoveForwardSlot1" type="Button" parent="Layout/Scroll/Table"]
custom_minimum_size = Vector2(128, 0)
size_flags_horizontal = 3
tooltip_text = "Rebind Move Forward (slot 1)"
text = "Unbound"

[node name="MoveForwardSlot2" type="Button" parent="Layout/Scroll/Table"]
custom_minimum_size = Vector2(128, 0)
size_flags_horizontal = 3
tooltip_text = "Rebind Move Forward (slot 2)"
text = "Unbound"

[node name="MoveForwardReset" type="Button" parent="Layout/Scroll/Table"]
tooltip_text = "Restore the shipped bindings for Move Forward"
text = "Reset"

