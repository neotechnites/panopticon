[node name="Note" type="Label" parent="Frame/Dialog/Padding/Layout/Tabs/Audio"]
unique_name_in_owner = true
autowrap_mode = 3
editor_description = "Filled in, and shown, only when the project is missing an audio bus one of these sliders drives. Silence is the normal state."

[node name="Video" type="VBoxContainer" parent="Frame/Dialog/Padding/Layout/Tabs"]
theme_override_constants/separation = 8

[node name="Grid" type="GridContainer" parent="Frame/Dialog/Padding/Layout/Tabs/Video"]
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 4
columns = 3
editor_description = "Three shared columns -- name, control, readout -- so every row on the tab lines up by construction rather than by each row guessing the same magic pixel width."

[node name="DisplayModeName" type="Label" parent="Frame/Dialog/Padding/Layout/Tabs/Video/Grid"]
size_flags_vertical = 1
