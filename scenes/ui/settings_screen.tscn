[node name="EffectsValue" type="Label" parent="Frame/Dialog/Padding/Layout/Tabs/Audio/Grid"]
custom_minimum_size = Vector2(72, 0)
size_flags_vertical = 1
unique_name_in_owner = true
vertical_alignment = 1
horizontal_alignment = 2

[node name="MusicName" type="Label" parent="Frame/Dialog/Padding/Layout/Tabs/Audio/Grid"]
size_flags_vertical = 1
vertical_alignment = 1
text = "Music"

[node name="MusicSlider" type="HSlider" parent="Frame/Dialog/Padding/Layout/Tabs/Audio/Grid"]
custom_minimum_size = Vector2(220, 0)
size_flags_horizontal = 3
size_flags_vertical = 1
