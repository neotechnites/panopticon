[node name="VideoNote" type="Label" parent="Frame/Dialog/Padding/Layout/Tabs/Video"]
unique_name_in_owner = true
autowrap_mode = 3
text = "Resolution applies to the window; in either fullscreen mode the display's own resolution is used."
editor_description = "Rewritten at runtime by SettingsScreen._update_video_note. The text here is only what it says when the window is obeying; a display server that refuses the resize -- the editor's embedded Game window is the one that does -- makes it say so instead, because a silent refusal is indistinguishable from a broken control."

[node name="Controls" type="MarginContainer" parent="Frame/Dialog/Padding/Layout/Tabs"]

[node name="KeybindPanel" parent="Frame/Dialog/Padding/Layout/Tabs/Controls" instance=ExtResource("2_keybind_panel")]
