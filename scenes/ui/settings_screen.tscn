[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/settings_screen.gd" id="1_settings_screen"]
[ext_resource type="PackedScene" path="res://scenes/ui/keybind_panel.tscn" id="2_keybind_panel"]

[node name="SettingsScreen" type="Control"]
process_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
editor_description = "Every setting the player can change, on five tabs, laid out here rather than in code. MainMenu and PauseMenu both instantiate THIS scene, so there is one settings screen and it cannot drift into two. Its only dependency is the SettingsStore, which the script fetches for itself."
script = ExtResource("1_settings_screen")

[node name="Frame" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="Dialog" type="PanelContainer" parent="Frame"]
custom_minimum_size = Vector2(640, 560)
size_flags_horizontal = 4
size_flags_vertical = 4
editor_description = "A centred dialog of a deliberate size, not an edge-to-edge sheet. On a 1080p screen a full-width panel strands a 500px table in an acre of empty grey; shrink-centre keeps the controls together and reads the same at every resolution. It grows if a tab's contents need more than the minimum and never shrinks below them, and the minimum is sized to fit inside the smallest resolution the video tab offers (1280x720) with its margins."

[node name="Padding" type="MarginContainer" parent="Frame/Dialog"]
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="Layout" type="VBoxContainer" parent="Frame/Dialog/Padding"]
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Frame/Dialog/Padding/Layout"]
text = "SETTINGS"

[node name="Tabs" type="TabContainer" parent="Frame/Dialog/Padding/Layout"]
size_flags_vertical = 3
editor_description = "Tab titles come from the child node names, so the order the tabs appear in is the order they are authored in here."

[node name="Match" type="VBoxContainer" parent="Frame/Dialog/Padding/Layout/Tabs"]
theme_override_constants/separation = 8
editor_description = "Rules of the round the player is allowed to choose, as opposed to presentation. First tab because it is the one thing on this screen you change on the way IN to a match rather than during one. Everything here is written over the MatchRules the match runs with by the SettingsBoot node in scenes/match/match.tscn, and the defaults on both sides agree."

[node name="Grid" type="GridContainer" parent="Frame/Dialog/Padding/Layout/Tabs/Match"]
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 4
columns = 3
editor_description = "Three shared columns -- name, control, readout -- so every row on the tab lines up by construction rather than by each row guessing the same magic pixel width."

[node name="GhostsName" type="Label" parent="Frame/Dialog/Padding/Layout/Tabs/Match/Grid"]
size_flags_vertical = 1
vertical_alignment = 1
text = "Ghosts"

[node name="GhostsCheck" type="CheckBox" parent="Frame/Dialog/Padding/Layout/Tabs/Match/Grid"]
size_flags_horizontal = 0
unique_name_in_owner = true
text = "Catch and swap"

[node name="GhostsSpacer" type="Control" parent="Frame/Dialog/Padding/Layout/Tabs/Match/Grid"]

[node name="RaceName" type="Label" parent="Frame/Dialog/Padding/Layout/Tabs/Match/Grid"]
size_flags_vertical = 1
vertical_alignment = 1
text = "Opening Race"

[node name="SkipRaceCheck" type="CheckBox" parent="Frame/Dialog/Padding/Layout/Tabs/Match/Grid"]
size_flags_horizontal = 0
unique_name_in_owner = true
text = "Skip it"

[node name="RaceSpacer" type="Control" parent="Frame/Dialog/Padding/Layout/Tabs/Match/Grid"]

[node name="SeatName" type="Label" parent="Frame/Dialog/Padding/Layout/Tabs/Match/Grid"]
size_flags_vertical = 1
vertical_alignment = 1
text = "Tower Goes To"

[node name="TowerSeatOption" type="OptionButton" parent="Frame/Dialog/Padding/Layout/Tabs/Match/Grid"]
custom_minimum_size = Vector2(220, 0)
size_flags_horizontal = 0
size_flags_vertical = 1
unique_name_in_owner = true
editor_description = "Empty here on purpose. The seats are filled in by SettingsScreen._fill_choices from the shipped match rules, exactly as the display-mode and resolution lists are filled from their enums: a list typed into this scene would fall out of step with prisoner_count the first time anybody changed it. It is greyed out while the race is not being skipped, because there is nothing to hand the tower to when the tower is being raced for."

[node name="SeatSpacer" type="Control" parent="Frame/Dialog/Padding/Layout/Tabs/Match/Grid"]

[node name="GhostsNote" type="Label" parent="Frame/Dialog/Padding/Layout/Tabs/Match"]
autowrap_mode = 3
editor_description = "What the mechanic is, for a player who has not met it. Nothing more: this is a description, not a disclaimer."
text = "A shot prisoner returns as a ghost: faster, unshootable, and chasing. Catching a living prisoner takes their place, and their distance round the ring with it."

[node name="RaceNote" type="Label" parent="Frame/Dialog/Padding/Layout/Tabs/Match"]
autowrap_mode = 3
editor_description = "What skipping costs and what it does not, for a player deciding whether to. The second sentence is the one that matters: the round a skip produces is the round a race would have produced, so a skipped match is still the game."
text = "A match normally opens with a race for the tower: everybody runs the ring and the first to the end takes it. Skip it and the tower is handed to the seat above instead, on turn one, with everybody else already running -- the same round the race would have started."

[node name="Game" type="VBoxContainer" parent="Frame/Dialog/Padding/Layout/Tabs"]
theme_override_constants/separation = 8

[node name="Grid" type="GridContainer" parent="Frame/Dialog/Padding/Layout/Tabs/Game"]
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 4
columns = 3
editor_description = "Three shared columns -- name, control, readout -- so every row on the tab lines up by construction rather than by each row guessing the same magic pixel width."

[node name="SensitivityName" type="Label" parent="Frame/Dialog/Padding/Layout/Tabs/Game/Grid"]
size_flags_vertical = 1
vertical_alignment = 1
text = "Mouse Sensitivity"

[node name="SensitivitySlider" type="HSlider" parent="Frame/Dialog/Padding/Layout/Tabs/Game/Grid"]
custom_minimum_size = Vector2(220, 0)
size_flags_horizontal = 3
size_flags_vertical = 1
unique_name_in_owner = true

[node name="SensitivityValue" type="Label" parent="Frame/Dialog/Padding/Layout/Tabs/Game/Grid"]
custom_minimum_size = Vector2(72, 0)
size_flags_vertical = 1
unique_name_in_owner = true
vertical_alignment = 1
horizontal_alignment = 2

[node name="InvertName" type="Label" parent="Frame/Dialog/Padding/Layout/Tabs/Game/Grid"]
size_flags_vertical = 1
vertical_alignment = 1
text = "Invert Look Y"

[node name="InvertCheck" type="CheckBox" parent="Frame/Dialog/Padding/Layout/Tabs/Game/Grid"]
size_flags_horizontal = 0
unique_name_in_owner = true

[node name="InvertSpacer" type="Control" parent="Frame/Dialog/Padding/Layout/Tabs/Game/Grid"]

[node name="FovName" type="Label" parent="Frame/Dialog/Padding/Layout/Tabs/Game/Grid"]
size_flags_vertical = 1
vertical_alignment = 1
text = "Field of View"

[node name="FovSlider" type="HSlider" parent="Frame/Dialog/Padding/Layout/Tabs/Game/Grid"]
custom_minimum_size = Vector2(220, 0)
size_flags_horizontal = 3
size_flags_vertical = 1
unique_name_in_owner = true

[node name="FovValue" type="Label" parent="Frame/Dialog/Padding/Layout/Tabs/Game/Grid"]
custom_minimum_size = Vector2(72, 0)
size_flags_vertical = 1
unique_name_in_owner = true
vertical_alignment = 1
horizontal_alignment = 2

[node name="Note" type="Label" parent="Frame/Dialog/Padding/Layout/Tabs/Game"]
autowrap_mode = 3
text = "Sensitivity and invert-Y are written into the active MovementProfile; field of view into the player camera."

[node name="Audio" type="VBoxContainer" parent="Frame/Dialog/Padding/Layout/Tabs"]
theme_override_constants/separation = 8

[node name="Grid" type="GridContainer" parent="Frame/Dialog/Padding/Layout/Tabs/Audio"]
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 4
columns = 3
editor_description = "Three shared columns -- name, control, readout -- so every row on the tab lines up by construction rather than by each row guessing the same magic pixel width."

[node name="MasterName" type="Label" parent="Frame/Dialog/Padding/Layout/Tabs/Audio/Grid"]
size_flags_vertical = 1
vertical_alignment = 1
text = "Master"

[node name="MasterSlider" type="HSlider" parent="Frame/Dialog/Padding/Layout/Tabs/Audio/Grid"]
custom_minimum_size = Vector2(220, 0)
size_flags_horizontal = 3
size_flags_vertical = 1
unique_name_in_owner = true

[node name="MasterValue" type="Label" parent="Frame/Dialog/Padding/Layout/Tabs/Audio/Grid"]
custom_minimum_size = Vector2(72, 0)
size_flags_vertical = 1
unique_name_in_owner = true
vertical_alignment = 1
horizontal_alignment = 2

[node name="EffectsName" type="Label" parent="Frame/Dialog/Padding/Layout/Tabs/Audio/Grid"]
size_flags_vertical = 1
vertical_alignment = 1
text = "Effects"

[node name="EffectsSlider" type="HSlider" parent="Frame/Dialog/Padding/Layout/Tabs/Audio/Grid"]
custom_minimum_size = Vector2(220, 0)
size_flags_horizontal = 3
size_flags_vertical = 1
