[node name="MainMenu" type="Control"]
process_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("12_theme")
editor_description = "The game's entry point: run/main_scene points here. World is the 3D backdrop -- the tower, its watching eye and an orbiting camera -- and UI is the Play/Host/Settings/Quit list drawn over it. scripts/ui/main_menu.gd binds and navigates; it builds nothing. Play leads to MatchSetupScreen; Host is a placeholder until the net lobby UI exists; Settings and the match/pause menu are named by path rather than instanced, for the same cycle reason documented there before."
script = ExtResource("1_main_menu")

[node name="SettingsBoot" type="Node" parent="."]
script = ExtResource("2_settings_boot")
movement_profile = ExtResource("3_movement_profile")

[node name="GameAudio" parent="." instance=ExtResource("4_game_audio")]

[node name="World" type="Node3D" parent="."]
editor_description = "The 3D backdrop: tower.glb and its watching eye, standing alone rather than in a ring, with their own MenuWatchingEyeProfile (menu_watching_eye_profile.tres) so the shooter-exclusion column is tuned for THIS scene rather than borrowed from bentham_ring.tscn's. The orbit camera never comes within 34 m of the axis; the profile's 9 m exclusion radius is never hit."

[node name="Environment" type="WorldEnvironment" parent="World"]
environment = SubResource("Env_menu")

