[node name="Handover" type="Control" parent="HUD/Root"]
visible = false
anchor_left = 0.5
anchor_top = 0.28
anchor_right = 0.5
anchor_bottom = 0.28
offset_left = -300.0
offset_right = 300.0
offset_bottom = 92.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
editor_description = "The tower changing hands, announced. Raised by scripts/match/match_hud.gd on MatchController.seat_changed, held for MatchAnnouncementProfile.handover_seconds and faded out; the script only sets visible, modulate and two strings, and every node under here is authored in this file. Hidden as authored because MatchHud takes it down in _ready anyway and a banner that flashed on the first frame of every match would be worse than one the editor shows folded. Placed at 28% of the screen height rather than at the centre: it clears the role readout above it at every supported resolution, and it leaves the crosshair, the ring and the horizon unobscured, which is the whole point of announcing a seat change to somebody who is at that moment being put back on the start line. mouse_filter IGNORE, like every other node in this HUD."

[node name="Backdrop" type="ColorRect" parent="HUD/Root/Handover"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0, 0, 0, 0.55)
editor_description = "Unstyled and deliberately dark: the banner is read against the deck, the sky and a lit tower depending on where the player is standing when the seat changes, and white text alone is illegible over at least one of them. Alpha rather than opaque so the arena is still visible through it."

[node name="Layout" type="VBoxContainer" parent="HUD/Root/Handover"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
alignment = 1
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="HUD/Root/Handover/Layout"]
theme_override_font_sizes/font_size = 34
text = "RUNNER 2 TAKES THE TOWER"
horizontal_alignment = 1
editor_description = "Who took it, in one line, big enough to read without looking away from the ring. The text authored here is the placeholder the editor shows; MatchHud overwrites it from the participant every time the seat changes, and phrases the human's own line as YOU TAKE THE TOWER rather than the broken \"You takes\"."

[node name="Detail" type="Label" parent="HUD/Root/Handover/Layout"]
theme_override_font_sizes/font_size = 16
text = "TURN 2"
horizontal_alignment = 1
editor_description = "Which turn in the tower this is for them, which is the number that matters: the reload shortens with every turn a player takes, so a third turn is a materially more dangerous tower than a first one and the runners are entitled to know."

[node name="Crosshair" type="Label" parent="HUD/Root"]
anchor_left = 0.5
