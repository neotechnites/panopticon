[gd_scene load_steps=12 format=3]

[ext_resource type="PackedScene" path="res://scenes/ring/test_ring.tscn" id="1_arena"]
[ext_resource type="PackedScene" path="res://scenes/player/player.tscn" id="2_player"]
[ext_resource type="PackedScene" path="res://scenes/weapon/rifle.tscn" id="3_rifle"]
[ext_resource type="PackedScene" path="res://scenes/bot/ring_runner.tscn" id="4_runner"]
[ext_resource type="Script" path="res://scripts/match/match_controller.gd" id="5_controller"]
[ext_resource type="Script" path="res://scripts/match/match_hud.gd" id="6_hud"]
[ext_resource type="Resource" path="res://resources/rules/default_match_rules.tres" id="7_rules"]
[ext_resource type="PackedScene" path="res://scenes/ui/pause_menu.tscn" id="8_pause_menu"]
[ext_resource type="Resource" path="res://scenes/player/default_movement_profile.tres" id="9_movement_profile"]
[ext_resource type="PackedScene" path="res://scenes/fx/feedback_rig.tscn" id="10_feedback_rig"]
[ext_resource type="PackedScene" path="res://scenes/audio/game_audio.tscn" id="11_game_audio"]

[node name="Match" type="Node3D"]
editor_description = "A whole match. Arena, one human body, three AI bodies, one rifle, and MatchController enforcing the match described by resources/rules/default_match_rules.tres: an opening race with no shooter, then rounds, with the tower passing to whoever reaches the end and the match going to whoever holds it through a round. Nothing under scenes/player, scenes/weapon, scenes/bot or scenes/ring is modified here -- they are composed."

[node name="Arena" parent="." instance=ExtResource("1_arena")]

[node name="Runners" type="Node3D" parent="."]
editor_description = "Empty by design. MatchController spawns the AI participants into it when a match starts, and they live for the whole match -- a converted runner is parked out of the world, not freed, because the round restarts the moment the seat changes and they are back on the ring in the same frame. Sweeping this between rounds would destroy the identities the turn counts are attached to."

[node name="Player" parent="." instance=ExtResource("2_player")]
editor_description = "The human's body -- one participant among four, not \"the shooter\". MatchController puts it on the TowerSpawn marker or on a lane depending on whether the human holds the seat that round, and the match opens with a race in which it is on a lane like everybody else. The transform saved here is what the editor shows and what the first physics tick sees."
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0)

[node name="Rifle" parent="Player/Head" node_paths=PackedStringArray("aim_source", "shooter_body", "tracer_parent") instance=ExtResource("3_rifle")]
editor_description = "Authored on the human's head, but it does not stay there: the rifle belongs to whoever holds the tower, and MatchController reparents it onto the seat holder's Head and repoints aim_source and shooter_body at that body. It is stowed on the controller itself during the opening race, when the tower is nobody's. The exports here are the starting values and what the editor shows. The shot line is the eye's, so the round goes exactly where the crosshair is with no muzzle parallax to explain; shooter_body excludes the holder's own capsule, without which every shot is a point-blank self-hit."
aim_source = NodePath("../Camera")
shooter_body = NodePath("../..")
tracer_parent = NodePath("../../..")

[node name="MatchController" type="Node" parent="." node_paths=PackedStringArray("arena", "player", "rifle", "runner_container")]
script = ExtResource("5_controller")
rules = ExtResource("7_rules")
arena = NodePath("../Arena")
player = NodePath("../Player")
rifle = NodePath("../Player/Head/Rifle")
runner_container = NodePath("../Runners")
runner_scene = ExtResource("4_runner")

[node name="HUD" type="CanvasLayer" parent="."]

[node name="Root" type="Control" parent="HUD" node_paths=PackedStringArray("controller", "rifle", "status_label", "match_label", "outcome_label")]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("6_hud")
controller = NodePath("../../MatchController")
rifle = NodePath("../../Player/Head/Rifle")
status_label = NodePath("Status")
match_label = NodePath("Match")
outcome_label = NodePath("Outcome")

[node name="Status" type="Label" parent="HUD/Root"]
offset_left = 12.0
offset_top = 8.0
offset_right = 720.0
offset_bottom = 32.0

[node name="Match" type="Label" parent="HUD/Root"]
editor_description = "The match, as opposed to the round: phase, who holds the tower, and every participant's turn count. Multi-line and unstyled on purpose -- the seat is a role that passes between players including AI, and a player standing on a lane has no other way to tell who they are running from or how fast that player's reload has become."
offset_left = 12.0
offset_top = 36.0
offset_right = 720.0
offset_bottom = 180.0
vertical_alignment = 0

[node name="Outcome" type="Label" parent="HUD/Root"]
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -120.0
offset_top = -48.0
offset_right = 120.0
offset_bottom = -24.0
grow_horizontal = 2
grow_vertical = 2
horizontal_alignment = 1

[node name="Crosshair" type="Label" parent="HUD/Root"]
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -12.0
offset_top = -10.0
offset_right = 12.0
offset_bottom = 14.0
grow_horizontal = 2
grow_vertical = 2
text = "+"
horizontal_alignment = 1

[node name="FeedbackRig" parent="." instance=ExtResource("10_feedback_rig")]
editor_description = "The hit-and-kill feedback layer, pointed at the human. Purely additive: every node here subscribes to signals Rifle and MatchController already emit, no gameplay script is touched, and deleting this node leaves the match exactly as it was. On CanvasLayer 2 it draws above the HUD (layer 1) and below PauseMenu (layer 128), so a hitmarker covers the crosshair and a menu covers both. It is placed BEFORE PauseMenu in child order so PauseMenu stays the last child, which is what gives the menu first refusal on GUI input; the two Controls in here are mouse_filter IGNORE anyway. Inert with no display server -- each node checks DisplayServer at _ready, connects nothing and stops processing -- so tools/harness/ pays nothing for it. The six exports the rig deliberately ships blank are filled in on the four child nodes below, and each one is listed in that node's own node_paths header: a NodePath export that is NOT named there resolves to null at load with no error at all, which is exactly how PauseMenu.camera was silently broken once already."

[node name="CameraKick" parent="FeedbackRig" index="0" node_paths=PackedStringArray("camera")]
editor_description = "The human camera is the one the feedback moves. An AI seat holder has its own Camera3D and its own eyes; this rig speaks only for the player looking at the screen."
camera = NodePath("../../Player/Head/Camera")

[node name="WeaponFeel" parent="FeedbackRig" index="1" node_paths=PackedStringArray("rifle", "owner_body")]
editor_description = "owner_body is load-bearing. There is ONE rifle in this match and MatchController reparents it onto whoever takes the tower, so Rifle.fired reaches this node whether the human pulled the trigger or a bot did. Without the owner check an AI seat holder's shot kicks the human's camera."
rifle = NodePath("../../Player/Head/Rifle")
owner_body = NodePath("../../Player")

[node name="HitConfirm" parent="FeedbackRig" index="2" node_paths=PackedStringArray("rifle", "controller", "owner_body")]
editor_description = "Both extra exports are load-bearing. controller is what tells a person from a pillar: Rifle.target_hit fires for the deck, the cover and the tower wall as readily as for a runner, and with controller left null resolve_participant is never consulted and every wall reads as a kill. owner_body is what keeps the marker on the right screen, for the same one-rifle reason as WeaponFeel above."
rifle = NodePath("../../Player/Head/Rifle")
controller = NodePath("../../MatchController")
owner_body = NodePath("../../Player")

[node name="HitReaction" parent="FeedbackRig" index="3" node_paths=PackedStringArray("rifle", "body")]
editor_description = "body is the human's capsule, and it is the opposite test to owner_body above: this node fires when the human is the one who was SHOT, not the one who fired, so it compares the reported collider against this body and ignores every hit on anybody else."
rifle = NodePath("../../Player/Head/Rifle")
body = NodePath("../../Player")

[node name="GameAudio" parent="." instance=ExtResource("11_game_audio")]
editor_description = "The whole audio system for the match, as one node. The root IS the AudioDirector and registers itself statically on entering the tree, so AudioDirector.post_event() from anywhere reaches it. Nothing is wired by NodePath on purpose: its MatchAudio listener searches the running scene root for the Rifle and the MatchController, because MatchController reparents the rifle onto whoever holds the tower and a path typed into this file would go stale on the first seat change. Subscription happens in _enter_tree, which Godot runs across the whole subtree before any _ready, so the match_started and race_started that MatchController.start_match() emits from its own _ready are heard wherever this node sits in child order. Under the default Activation.AUTO the director switches itself off in a headless run, so the bot harness pays nothing for it either."

[node name="PauseMenu" parent="." node_paths=PackedStringArray("camera") instance=ExtResource("8_pause_menu")]
editor_description = "Escape, and everything behind it. Last child of the root and on CanvasLayer 128, so it draws over the HUD (layer 1) and is offered GUI input before it; the HUD cannot swallow a click meant for a menu button because HUD/Root is mouse_filter 2 and its Labels ignore the mouse anyway. movement_profile is the SAME .tres instance Player uses for its own profile export -- Godot returns one cached object per resource path and this one is not local_to_scene -- so mouse sensitivity and invert-Y written by the settings screen land on the profile the body actually reads; point it anywhere else and the setting appears to save and does nothing. camera is named in node_paths in the header above: without that entry the NodePath resolves to null at load with no error, and the display-FOV setting silently stops working."
movement_profile = ExtResource("9_movement_profile")
camera = NodePath("../Player/Head/Camera")
