offset_top = -10.0
offset_right = 12.0
offset_bottom = 14.0
grow_horizontal = 2
grow_vertical = 2
text = "+"
horizontal_alignment = 1

[node name="FeedbackRig" parent="." instance=ExtResource("10_feedback_rig")]
editor_description = "The hit-and-kill feedback layer, pointed at the human. Purely additive: every node here subscribes to signals Rifle and MatchController already emit, no gameplay script is touched, and deleting this node leaves the match exactly as it was. On CanvasLayer 2 it draws above the HUD (layer 1) and below PauseMenu (layer 128), so a hitmarker covers the crosshair and a menu covers both. It is placed BEFORE PauseMenu in child order so PauseMenu stays the last child, which is what gives the menu first refusal on GUI input; the two Controls in here are mouse_filter IGNORE anyway. Inert with no display server -- each node checks DisplayServer at _ready, connects nothing and stops processing -- so tools/harness/ pays nothing for it. The eight exports the rig deliberately ships blank are filled in on the five child nodes below, and each one is listed in that node's own node_paths header: a NodePath export that is NOT named there resolves to null at load with no error at all, which is exactly how PauseMenu.camera was silently broken once already."

[node name="CameraKick" parent="FeedbackRig" index="0" node_paths=PackedStringArray("camera")]
editor_description = "The human camera is the one the feedback moves. An AI seat holder has its own Camera3D and its own eyes; this rig speaks only for the player looking at the screen."
camera = NodePath("../../Player/Head/Camera")

[node name="WeaponFeel" parent="FeedbackRig" index="1" node_paths=PackedStringArray("rifle", "owner_body")]
editor_description = "owner_body is load-bearing. There is ONE rifle in this match and MatchController reparents it onto whoever takes the tower, so Rifle.fired reaches this node whether the human pulled the trigger or a bot did. Without the owner check an AI seat holder's shot kicks the human's camera."
rifle = NodePath("../../Player/Head/Rifle")
owner_body = NodePath("../../Player")

[node name="HitConfirm" parent="FeedbackRig" index="2" node_paths=PackedStringArray("rifle", "controller", "owner_body")]
editor_description = "Both extra exports are load-bearing. controller is what tells a person from a pillar: Rifle.target_hit fires for the deck, the cover and the tower wall as readily as for a runner, and with controller left null resolve_participant is never consulted and every wall reads as a kill. owner_body is what keeps the marker on the right screen, for the same one-rifle reason as WeaponFeel above."
rifle = NodePath("../../Player/Head/Rifle")
controller = NodePath("../../MatchController")
owner_body = NodePath("../../Player")

[node name="HitReaction" parent="FeedbackRig" index="3" node_paths=PackedStringArray("rifle", "body")]
editor_description = "body is the human's capsule, and it is the opposite test to owner_body above: this node fires when the human is the one who was SHOT, not the one who fired, so it compares the reported collider against this body and ignores every hit on anybody else."
rifle = NodePath("../../Player/Head/Rifle")
body = NodePath("../../Player")

[node name="CatchReaction" parent="FeedbackRig" index="4" node_paths=PackedStringArray("controller", "body")]
editor_description = "Both exports are load-bearing and for opposite reasons. controller is the event AND the identity: MatchController.ghost_caught is the only announcement a catch makes, and MatchController.get_runner_palette() is where the other player's colour comes from -- the colour is how you know WHO, since there is no text on this. body is the filter: a catch has two participants, bots catch and are caught constantly, and without this every bot-on-bot swap in the round would paint the human's screen. With it a catch neither of whose sides is this body costs one pointer comparison and returns."
controller = NodePath("../../MatchController")
body = NodePath("../../Player")

[node name="GameAudio" parent="." instance=ExtResource("11_game_audio")]
editor_description = "The whole audio system for the match, as one node. The root IS the AudioDirector and registers itself statically on entering the tree, so AudioDirector.post_event() from anywhere reaches it. Nothing is wired by NodePath on purpose: its MatchAudio listener searches the running scene root for the Rifle and the MatchController, because MatchController reparents the rifle onto whoever holds the tower and a path typed into this file would go stale on the first seat change. Subscription happens in _enter_tree, which Godot runs across the whole subtree before any _ready, so the match_started and race_started that MatchController.start_match() emits from its own _ready are heard wherever this node sits in child order. Under the default Activation.AUTO the director switches itself off in a headless run, so the bot harness pays nothing for it either."

[node name="SpectatorView" type="Node3D" parent="." node_paths=PackedStringArray("controller", "camera", "player_camera", "human_input")]
editor_description = "What a dead player looks at. The three second respawn hold freezes the body -- MatchController._hold_body switches its physics off -- and the human camera is a child of that body, so without this node the player sits inside a statue unable even to turn their head, which is exactly what Ryan objected to. This node carries its OWN Camera3D and makes it current while MatchController.get_spectating_state() says the human is dead: orbiting the body for the three second hold, and up on the overlook watching the ring for a racer who fell during the opening race and is out for the rest of it. It never touches the player's camera -- WeaponOptic owns that camera's fov, FxCameraKick owns its local transform and PauseMenu writes the display FOV into it -- it only makes it current again on the way out. human_input is load-bearing and is a bug fix, not politeness: HumanIntentSource banks mouse motion in pixels and drains it when PlayerController polls, and a held body is not polling, so three seconds of banked mouse would land on the aim in one frame the instant the body woke. Muting it drops the bank and hands the mouse to this camera instead. Inert with no display server. Strictly additive: it subscribes to nothing, and deleting it leaves the match exactly as it was."
script = ExtResource("15_spectator")
controller = NodePath("../MatchController")
camera = NodePath("Camera")
player_camera = NodePath("../Player/Head/Camera")
human_input = NodePath("../Player/HumanInput")
profile = ExtResource("16_spectator_profile")

[node name="Camera" type="Camera3D" parent="SpectatorView"]
editor_description = "The spectator's own camera, deliberately NOT current in the scene as authored -- the player's camera is, and this one is switched in only while somebody is dead. Its fov is set from SpectatorProfile at _ready rather than borrowed from the player camera, which may be zoomed down a rifle scope at the moment its owner is shot."
current = false
fov = 75.0

[node name="SeatHandover" type="Node3D" parent="." node_paths=PackedStringArray("controller", "camera", "player_camera", "human_input", "optic")]
editor_description = "The tower changing hands, as the player experiences it. A seat change is MatchController.start_round() writing a new global_position onto every body on one tick, and the human camera is a child of one of those bodies, so the biggest moment in the match used to arrive as a single-frame teleport that said nothing. This node holds the view still for a beat at the pose the player was in, then flies its OWN camera to wherever the player camera has ended up, arcing over the deck so the flight does not skim through the ring cover. It never writes the player camera -- WeaponOptic owns that camera's fov, FxCameraKick owns its local transform and PauseMenu writes the display FOV into it -- only its `current` flag, which it sets back on the way out. human_input is the same banked-mouse fix FxSpectatorView documents: a body being placed is held inert and not polling, so a second of unmuted mouse would land on the aim in one frame the instant it woke. optic is what stops a player who lost the tower mid-shot starting their next lap looking down a scope. FxSpectatorView outranks this node: it does not arm while the human is dead and stands down on the frame they die. Inert with no display server, so bot sweeps pay nothing. Strictly additive -- it subscribes to signals MatchController already emits, is subscribed to by nothing, and deleting it restores the instant cut."
script = ExtResource("18_handover")
controller = NodePath("../MatchController")
camera = NodePath("Camera")
player_camera = NodePath("../Player/Head/Camera")
human_input = NodePath("../Player/HumanInput")
optic = NodePath("../Player/Optic")
profile = ExtResource("19_handover_profile")

[node name="Camera" type="Camera3D" parent="SeatHandover"]
editor_description = "The handover's own camera, deliberately NOT current as authored. It is switched in for about a second when the seat changes hands and switched straight back out. Its fov is written every frame of the flight from the player camera's own value plus SeatHandoverProfile.fov_surge_degrees, so the player's display-FOV setting survives the trip."
current = false

[node name="DeathScreen" type="CanvasLayer" parent="." node_paths=PackedStringArray("controller")]
editor_description = "The legible half of being dead: DOWN plus a live countdown of MatchController.get_respawn_hold_remaining(), or OUT OF THE RACE with no number because a race has no deadline anybody can compute. On layer 3 it draws above the HUD (1) and the feedback rig (2) and far below PauseMenu (128), so a player can still pause while dead. Built in code like every other menu here, polls rather than subscribing, and inert with no display server."
script = ExtResource("17_death_screen")
controller = NodePath("../MatchController")

[node name="RoundTransition" parent="." node_paths=PackedStringArray("controller", "pause_menu") instance=ExtResource("22_round_transition")]
editor_description = "The card between two rounds. Ryan: \"maybe lets have a transition screen each round that shows the map or something\". A round used to end and the next one begin on the same tick -- MatchController.start_round() writes a new global_position onto every body in the match -- so the biggest structural moment in a match arrived as a teleport with nothing said. This node raises a card on MatchController.round_started showing the round number, the map, who holds the tower and on what turn, and how many prisoners are on the ring, over a LIVE overhead render of the arena drawn by a Camera3D inside its own SubViewport. That subviewport is the whole reason this is safe: a camera in a SubViewport is current in that viewport and nowhere else, so this node never touches Camera3D.current on the main viewport and is never ranked against FxSpectatorView or SeatHandover. It pauses the tree for the card\'s length so no bot runs a metre of the new round while the player reads it, and it only ever unpauses a pause it set itself -- never while PauseMenu is open, which is the objection ResultScreen\'s own header raises against pausing. Skippable by any key after a fifth of a second, never shown headless (so the bot harness and the test suite cross a round boundary with no delay at all), and a no-op in a match with no human in it. Durations live on default_match_announcement.tres alongside the handover banner and the win beat, because they are one pacing decision; round_card_seconds = 0 takes the card off entirely. Placed BEFORE ResultScreen and PauseMenu in child order for the same reason ResultScreen is: PauseMenu must stay the last child to keep first refusal on GUI input, and layer 32 draws under both of them anyway."
controller = NodePath("../MatchController")
pause_menu = NodePath("../PauseMenu")
announcements = ExtResource("20_announcements")

[node name="ResultScreen" parent="." node_paths=PackedStringArray("controller", "pause_menu") instance=ExtResource("13_result_screen")]
editor_description = "The end of the match, told to the player. MatchController already knew who had won and froze the world; until this node existed it told nobody, and a second match meant relaunching the game. It listens for match_won, reads the winner and every number off the controller -- it keeps no score of its own -- and offers Play Again (MatchController.restart(), the same call the R key makes, so no scene is reloaded and no state is rebuilt that a reset already reaches) and Main Menu. pause_menu is named so the main-menu teardown is PauseMenu's one implementation rather than a second copy of the same four steps; it is also how the screen knows to take the mouse back when a pause menu closed over the top of it and restored the match's captured mouse. Placed BEFORE PauseMenu in child order deliberately: PauseMenu must stay the last child to keep first refusal on GUI input, and its layer 128 draws over this screen's 64 either way."
controller = NodePath("../MatchController")
pause_menu = NodePath("../PauseMenu")
announcements = ExtResource("20_announcements")

[node name="PauseMenu" parent="." node_paths=PackedStringArray("camera") instance=ExtResource("8_pause_menu")]
editor_description = "Escape, and everything behind it. Last child of the root and on CanvasLayer 128, so it draws over the HUD (layer 1) and is offered GUI input before it; the HUD cannot swallow a click meant for a menu button because HUD/Root is mouse_filter 2 and its Labels ignore the mouse anyway. movement_profile is the SAME .tres instance Player uses for its own profile export -- Godot returns one cached object per resource path and this one is not local_to_scene -- so mouse sensitivity and invert-Y written by the settings screen land on the profile the body actually reads; point it anywhere else and the setting appears to save and does nothing. camera is named in node_paths in the header above: without that entry the NodePath resolves to null at load with no error, and the display-FOV setting silently stops working."
movement_profile = ExtResource("9_movement_profile")
camera = NodePath("../Player/Head/Camera")
