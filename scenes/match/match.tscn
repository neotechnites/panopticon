[node name="Readout" type="Control" parent="HUD/Root"]
offset_left = 12.0
offset_top = 10.0
offset_right = 404.0
offset_bottom = 138.0
mouse_filter = 2
editor_description = "What the player needs to know, and only that. Four lines whose CONTENT depends on the role the human is playing -- tower, prisoner, ghost, or watching -- because the two sides of this game do not share a single interesting number. scripts/match/match_hud.gd writes four strings and four colours off resources/rules/default_match_readout.tres and nothing else; every node under here is authored in this file. Top-left at 392x128 on purpose: it clears the crosshair, the ring band and the horizon at every supported resolution, which matters because the guard is shooting 0.4 m targets at 35-60 m and the prisoner is reading cover at a run. Hidden by MatchHud whenever the match has no human participant, which is every headless bot sweep. mouse_filter IGNORE, like every other node in this HUD."

[node name="Backdrop" type="ColorRect" parent="HUD/Root/Readout"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0, 0, 0, 0.42)
editor_description = "The arena is lit by ONE red light above the tower and is deliberately dark, so this readout is drawn over black concrete, red-lit concrete, a lit tower and the sky depending on where the player is standing. Text alone is illegible over at least two of those. Translucent rather than opaque so the deck is still visible through it, and pure black rather than tinted so it darkens the red light instead of joining it."

[node name="Lines" type="VBoxContainer" parent="HUD/Root/Readout"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 10.0
offset_top = 6.0
offset_right = -10.0
offset_bottom = -6.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/separation = 2

[node name="Role" type="Label" parent="HUD/Root/Readout/Lines"]
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.9)
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 18
text = "TOWER  ·  TURN 2"
editor_description = "What you ARE. Placeholder text for the editor; MatchHud overwrites it every frame. The seat holder's turn count rides on this line rather than below it because the reload shortens with every turn, so the turn number IS how dangerous this tower is."

[node name="Primary" type="Label" parent="HUD/Root/Readout/Lines"]
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.9)
theme_override_constants/outline_size = 7
theme_override_font_sizes/font_size = 40
text = "RELOAD 1.8"
editor_description = "The one number the role lives on, at a size that can be read in peripheral vision without looking away from the ring: the reload countdown in the tower, the metres left on the ring, the orders as a ghost. Its COLOUR is written by MatchHud off MatchReadoutProfile -- amber reloading, green ready, cyan as a ghost -- and never red, because red is the only light in this arena and a red reload countdown would vanish into the deck."

[node name="Objective" type="Label" parent="HUD/Root/Readout/Lines"]
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.9)
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 16
text = "PRISONERS 2 / 3  ·  CONVERT THEM ALL"
editor_description = "How many prisoners are still alive, and what the rules IN PLAY say winning is. Both halves are read off the live MatchRules rather than assumed: the runners' half changes under ALL_ARRIVALS, and a shooter win condition MatchRules declares but does not implement says so instead of being described as the one that is."

[node name="Context" type="Label" parent="HUD/Root/Readout/Lines"]
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.9)
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 14
text = "TOWER Runner 2  ·  TURN 2  ·  2.3S RELOAD"
editor_description = "Dim, and last, because it is true rather than urgent. A runner gets the tower: who is in it, on which turn, and how LONG their silence between shots lasts -- deliberately not how much of it is left, which is the guard's number and nobody else's. The seat holder gets match progress instead."

[node name="Hint" type="Label" parent="HUD/Root"]
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 12.0
offset_top = -28.0
offset_right = 280.0
offset_bottom = -6.0
grow_vertical = 0
mouse_filter = 2
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.9)
theme_override_constants/outline_size = 5
theme_override_font_sizes/font_size = 13
text = "[R] restart match"
editor_description = "The restart key, which is a development affordance and is dressed as one: bottom-left, 13 px and dim, where it is findable and is not competing with the reload. MatchReadoutProfile.show_restart_hint takes it off entirely."

