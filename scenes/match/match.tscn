[gd_scene load_steps=7 format=3]

[ext_resource type="PackedScene" path="res://scenes/ring/test_ring.tscn" id="1_arena"]
[ext_resource type="PackedScene" path="res://scenes/player/player.tscn" id="2_player"]
[ext_resource type="PackedScene" path="res://scenes/weapon/rifle.tscn" id="3_rifle"]
[ext_resource type="PackedScene" path="res://scenes/bot/ring_runner.tscn" id="4_runner"]
[ext_resource type="Script" path="res://scripts/match/match_controller.gd" id="5_controller"]
[ext_resource type="Script" path="res://scripts/match/match_hud.gd" id="6_hud"]

[node name="Match" type="Node3D"]
editor_description = "The first playable round. Arena, one human in the tower with a rifle, three runners on the clear lanes, and MatchController holding every rule of the round. Nothing under scenes/player, scenes/weapon, scenes/bot or scenes/ring is modified here -- they are composed."

[node name="Arena" parent="." instance=ExtResource("1_arena")]

[node name="Runners" type="Node3D" parent="."]
editor_description = "Empty by design. MatchController spawns three runners into it on every round and sweeps it on restart, so nothing of a finished round survives into the next one."

[node name="Player" parent="." instance=ExtResource("2_player")]
editor_description = "The tower. Placed on the TowerSpawn marker here as well as by MatchController: the transform saved in the scene is what the editor shows and what the first physics tick sees, and the controller's placement is what a restart uses."
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0)

[node name="Rifle" parent="Player/Head" node_paths=PackedStringArray("aim_source", "shooter_body", "tracer_parent") instance=ExtResource("3_rifle")]
editor_description = "Parented to the head, not the body, so the barrel follows the pitch. The shot line is the camera's, though: aim_source is the Camera3D, so the round goes exactly where the crosshair is with no muzzle parallax to explain. shooter_body excludes the player's own capsule from the ray, without which every shot is a point-blank self-hit."
aim_source = NodePath("../Camera")
shooter_body = NodePath("../..")
tracer_parent = NodePath("../../..")

[node name="MatchController" type="Node" parent="." node_paths=PackedStringArray("arena", "player", "rifle", "runner_container")]
script = ExtResource("5_controller")
lane_radii = PackedFloat32Array(38.5, 44.5, 51)
arena = NodePath("../Arena")
player = NodePath("../Player")
rifle = NodePath("../Player/Head/Rifle")
runner_container = NodePath("../Runners")
runner_scene = ExtResource("4_runner")

[node name="HUD" type="CanvasLayer" parent="."]

[node name="Root" type="Control" parent="HUD" node_paths=PackedStringArray("controller", "rifle", "status_label", "outcome_label")]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("6_hud")
controller = NodePath("../../MatchController")
rifle = NodePath("../../Player/Head/Rifle")
status_label = NodePath("Status")
outcome_label = NodePath("Outcome")

