[node name="Start" type="Node3D" parent="Sections"]
editor_description = "Start pocket 5-14 deg: open grass and one boulder on the outside."

[node name="S1_Stand" type="Node3D" parent="Sections"]
editor_description = "S1 The Stand 14-74 deg: a trunk slalom, four trunks inside the lane so the corridor runs outside them in their shadow, then three outside so it runs inside them in full view."

[node name="Pocket_078" type="Node3D" parent="Sections"]
editor_description = "Rest pocket 74-82 deg: one standing stone inside the lane."

[node name="S2_Hedge" type="Node3D" parent="Sections"]
editor_description = "S2 The Bramble Hedge 82-142 deg: a lethal hedge laid along the lane in 6 m runs that change sides twice, hoppable at 0.96 m, with a thicket tall enough for head cover on the inside runs only."

[node name="Pocket_146" type="Node3D" parent="Sections"]
editor_description = "Rest pocket 142-150 deg: one standing stone inside the lane."

[node name="S3_Boulders" type="Node3D" parent="Sections"]
editor_description = "S3 The Boulder Field 152-214 deg: three standing stones 30 deg apart are the only head cover; the boulders between them hide a chest and not a head and the shelves are there to be jumped."

[node name="Pocket_218" type="Node3D" parent="Sections"]
editor_description = "Rest pocket 214-222 deg: one standing stone inside the lane."

[node name="S4_BoostRun" type="Node3D" parent="Sections"]
editor_description = "S4 The Boost Run 222-282 deg: three pads throw a runner 14.7 m down the lane over a thorn patch into a thicket's shadow; walking it is one outer corridor past the brambles."

[node name="Pocket_282" type="Node3D" parent="Sections"]
editor_description = "Rest pocket 278-286 deg: one standing stone inside the lane."

[node name="S5_Thicket" type="Node3D" parent="Sections"]
editor_description = "S5 The Thicket 286-320 deg: single file, one thicket per bay with the sides alternating every 9 deg, so every second bay is the naked one."

[node name="S6_LastGap" type="Node3D" parent="Sections"]
editor_description = "S6 The Last Gap 320-335 deg: one bare shelf, one last stone, then 11.8 m of nothing to the portal."

