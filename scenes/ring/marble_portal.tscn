[node name="Gate" type="Area3D" parent="." groups=["finish_gate"]]
editor_description = "The disc opening. A body has to overlap this to finish, not just cross the portal's angle -- see MatchLapTracker. The marble surround keeps the hell-rock portal's opening exactly (2.7 m clear at the ground, springing 2.60, apex 3.15, surface centre 1.50), so this volume is unmoved and unresized."
