[node name="Pit_080deg" type="CSGCylinder3D" parent="Ring/Level1" groups=["deck_pits"]]
editor_description = "80 deg, r=47.00, 5.0 m across: r44.50-r49.50, flush against the shoulder the cover band already ends at, so the racing line r49.50-r54.50 is not narrowed by a centimetre.\n\nIT IS A SHAFT, NOT A HOLE. The same cut is made through all three decks at this bearing and this radius. On a stacked arena a pit that only opened one floor would be a nine metre drop onto the deck below -- a shortcut backwards, not a hazard -- and a fall from the top level would never reach the kill volume. Cut through, it means the same thing on every level and ends in the same place."
operation = 2
radius = 2.5000
height = 7.0000
sides = 24
transform = Transform3D(1, 0, 0, 0, 1, 0, -0, 0, 1, 8.56507, 8.5, 46.213)

