[node name="KillBox" type="Area3D" parent="." unique_id=887311935]
editor_description = "The kill box under the one-level ring. Roof at y=-8.0 -- raised from the deeper roof this used to have so a body falling off the outer rim is caught before it lands on rock and gets stuck, rather than only one that falls all the way past the courtyard.

It is a trigger and nothing else: no collision of its own, monitorable off, mask 1048577 (bit 0, a living body's layer, plus bit 20, MatchController.GHOST_HAZARD_LAYER) so a ghost is seen falling too.

WHAT IT DOES IS NOT DECIDED HERE. scripts/match/kill_volume.gd resolves whatever entered to a participant and hands it to MatchController.handle_fall() -- the same door the rifle, the pit triggers and the red traps kill through."
collision_layer = 0
collision_mask = 1048577
monitorable = false
script = ExtResource("1_kill_volume")
radius_metres = 62.0
roof_depth_metres = 8.0
depth_metres = 34.0

