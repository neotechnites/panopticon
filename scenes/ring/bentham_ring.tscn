material = SubResource("MatRock")
transform = Transform3D(0.984808, 0, 0.173648, 0, 1, 0, -0.173648, 0, 0.984808, 51.21, 27.25, -9.02971)

[node name="Cover" type="Node3D" parent="."]
editor_description = "Cover on the one deck, two radial bands at r=47 and r=57 -- one either side of the racing line, which is what a 16 m deck has room for. Height 3.0 m: far above the 1.11 m jump, so it cannot be hopped, and tuned to the guard's 3 degree look down from the tower so a piece's shadow stays a few metres, not a corridor."

