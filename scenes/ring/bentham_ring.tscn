[node name="Kerb1" type="CSGCombiner3D" parent="Ring"]
editor_description = "Level 1's gallery rail, 0.5 m tall -- the same reasoning the original kerb shipped with, and it matters more now that the inner edge is a 20.0 m drop into the courtyard or onto the level below. It has to read as an edge without shadowing the deck behind it: the guard's line to a chest on this level's racing line is still 3.20 m above the deck as it crosses r=45.0."
use_collision = true

