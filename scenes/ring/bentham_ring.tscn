[node name="MapBase" parent="." unique_id=23449969 instance=ExtResource("10_map_base_model")]
editor_description = "assets/models/map_base.glb: the one deck -- annulus, pit wall down to the courtyard, outer wall up to the rim. Ships its own collision (MapBaseCollision-colonly), so nothing here duplicates it."

[node name="KillBox" type="Area3D" parent="." unique_id=887311935]
editor_description = "The kill box under the one-level ring. Roof at y=-8.0 -- raised from the deeper roof this used to have so a body falling off the outer rim is caught before it lands on rock and gets stuck, rather than only one that falls all the way past the courtyard.

It is a trigger and nothing else: no collision of its own, monitorable off, mask 1048577 (bit 0, a living body's layer, plus bit 20, MatchController.GHOST_HAZARD_LAYER) so a ghost is seen falling too.

WHAT IT DOES IS NOT DECIDED HERE. scripts/match/kill_volume.gd resolves whatever entered to a participant and hands it to MatchController.handle_fall() -- the same door the rifle, the pit triggers and the red traps kill through."
collision_layer = 0
collision_mask = 1048577
monitorable = false
script = ExtResource("1_kill_volume")
radius_metres = 62.0
roof_depth_metres = 8.0
depth_metres = 34.0

[node name="Shape" type="CollisionShape3D" parent="KillBox" unique_id=1105573957]
editor_description = "Deliberately empty. KillVolume._build_shape writes a CylinderShape3D over it on ready, from the exports on the parent."

[node name="StartEnd" type="Node3D" parent="." unique_id=1112986873]
editor_description = "One level, one lap: start and finish are both on the deck at y=23.0, 30 deg apart around the ring -- the gap is the old ramp bay, unused now."

[node name="PrisonerStart" type="Marker3D" parent="StartEnd" unique_id=1895677975]
editor_description = "5.0 deg on level one's racing line, y=23.0. Its ANGLE is what places the field -- MatchController deals them sideways across the width of the track from here -- but its HEIGHT is load-bearing too, and was the one number missed when the ring was lifted to put its top deck at the guard's eye: a marker left on the old datum is a start line nine metres under the floor, and every body dealt onto it falls out of the world before it has taken a step."
transform = Transform3D(-0.996195, 0, 0.0871557, 0, 1, 0, -0.0871557, 0, -0.996195, 51.8021, 23, 4.5321)

[node name="PrisonerEnd" type="Marker3D" parent="StartEnd" unique_id=2033520228]
editor_description = "345.0 deg on the level's racing line, y=23.0, matching the portal's own transform. This is the end of the whole route, not the end of a lap: reaching it is what takes the tower."
transform = Transform3D(0.965926, 0, 0.258819, 0, 1, 0, -0.258819, 0, 0.965926, 50.2281, 23, -13.4586)

[node name="Portal" parent="StartEnd" unique_id=759663694 instance=ExtResource("19_portal")]
editor_description = "The finish, further back toward the bars at 345 deg. A runner passes through the disc along the run direction: local Z is the pass-through axis, local X the 4.5 m span across the lane."
transform = Transform3D(0.965926, 0, 0.258819, 0, 1, 0, -0.258819, 0, 0.965926, 50.2281, 23, -13.4586)

