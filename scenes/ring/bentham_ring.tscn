[node name="KillBox" type="Area3D" parent="."]
editor_description = "The kill box under the one-level ring. Roof at y=-8.0 -- raised from the deeper roof this used to have so a body falling off the outer rim is caught before it lands on rock and gets stuck, rather than only one that falls all the way past the courtyard.\n\nIt is a trigger and nothing else: no collision of its own, monitorable off, mask 1048577 (bit 0, a living body's layer, plus bit 20, MatchController.GHOST_HAZARD_LAYER) so a ghost is seen falling too.\n\nWHAT IT DOES IS NOT DECIDED HERE. scripts/match/kill_volume.gd resolves whatever entered to a participant and hands it to MatchController.handle_fall() -- the same door the rifle, the pit triggers and the red traps kill through."
collision_layer = 0
collision_mask = 1048577
monitorable = false
script = ExtResource("1_kill_volume")
radius_metres = 62.0000
roof_depth_metres = 8.0000
depth_metres = 34.0000

[node name="Shape" type="CollisionShape3D" parent="KillBox"]
editor_description = "Deliberately empty. KillVolume._build_shape writes a CylinderShape3D over it on ready, from the exports on the parent."

[node name="StartEnd" type="Node3D" parent="."]
editor_description = "One level, one lap: start and finish are both on the deck at y=23.0, 30 deg apart around the ring -- the gap is the old ramp bay, unused now."

[node name="PrisonerStart" type="Marker3D" parent="StartEnd"]
editor_description = "5.0 deg on level one's racing line, y=23.0. Its ANGLE is what places the field -- MatchController deals them sideways across the width of the track from here -- but its HEIGHT is load-bearing too, and was the one number missed when the ring was lifted to put its top deck at the guard's eye: a marker left on the old datum is a start line nine metres under the floor, and every body dealt onto it falls out of the world before it has taken a step."
transform = Transform3D(-0.996195, 0, 0.0871557, 0, 1, 0, -0.0871557, 0, -0.996195, 51.8021, 23, 4.5321)

[node name="PrisonerEnd" type="Marker3D" parent="StartEnd"]
editor_description = "345.0 deg on the level's racing line, y=23.0, matching the portal's own transform. This is the end of the whole route, not the end of a lap: reaching it is what takes the tower."
transform = Transform3D(0.965926, 0, 0.258819, 0, 1, 0, -0.258819, 0, 0.965926, 50.2281, 23, -13.4586)

[node name="Portal" parent="StartEnd" instance=ExtResource("19_portal")]
editor_description = "The finish, further back toward the bars at 345 deg. A runner passes through the disc along the run direction: local Z is the pass-through axis, local X the 4.5 m span across the lane."
transform = Transform3D(0.965926, 0, 0.258819, 0, 1, 0, -0.258819, 0, 0.965926, 50.2281, 23, -13.4586)

[node name="RockBars" parent="." instance=ExtResource("20_rock_bars")]
editor_description = "Bars across the lane at 350 deg, in the gap between finish and start, so the finish is visible from the start. Local X (10.6 m) runs radially, local Z is tangential."
transform = Transform3D(1.28025, 0, 0.173648, 0, 1, 0, -0.225742, 0, 0.984808, 51.91, 23, -9.0297)

