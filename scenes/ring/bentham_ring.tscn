[node name="StartEnd" type="Node3D" parent="." unique_id=1112986873]
editor_description = "One level, one lap: start and finish are both on the deck at y=23.0, 30 deg apart around the ring -- the gap is the old ramp bay, unused now."

[node name="PrisonerStart" type="Marker3D" parent="StartEnd" unique_id=1895677975]
editor_description = "5.0 deg on level one's racing line, y=23.0. Its ANGLE is what places the field -- MatchController deals them sideways across the width of the track from here -- but its HEIGHT is load-bearing too, and was the one number missed when the ring was lifted to put its top deck at the guard's eye: a marker left on the old datum is a start line nine metres under the floor, and every body dealt onto it falls out of the world before it has taken a step."
transform = Transform3D(-0.996195, 0, 0.0871557, 0, 1, 0, -0.0871557, 0, -0.996195, 51.8021, 23, 4.5321)

[node name="PrisonerEnd" type="Marker3D" parent="StartEnd" unique_id=2033520228]
editor_description = "345.0 deg on the level's racing line, y=23.0, matching the portal's own transform. This is the end of the whole route, not the end of a lap: reaching it is what takes the tower."
