[node name="Route" type="Node3D" parent="." unique_id=325112563]
editor_description = "WHAT PROGRESS IS: the arc swept so far on the one lap, taken at the lane radius. IT IS DATA, AND IT LIVES ON THE MAP. The deck height, radial band, lane radius, entry angle and exit angle are here, and MatchLapTracker, RingRunner, the HUD and the round card all read them from here rather than from a second copy."
script = ExtResource("5_ring_route")

[node name="Level1" type="Node3D" parent="Route" unique_id=1688446961]
editor_description = "Level 1: deck y=23.0, r44.0-r60.0, lane r=52.0, 5 deg to 335 deg = 330 deg of lap, 299 m. Its exit is the finish of the whole route."
script = ExtResource("6_ring_level")
deck_height = 23.0
inner_radius = 46.7
outer_radius = 57.3
lane_radius = 52.0
entry_angle_degrees = 5.0
exit_angle_degrees = 335.0

[node name="Tower" type="Node3D" parent="." unique_id=1642350855]
editor_description = "The tower, and its origin is the FLOOR OF THE GUARD ROOM at y=25.35. That is the model's own datum: assets/models/tower.glb hangs its rock 36.4 m below this point and carries the top of its drum 9.6 m above it, so the model drops in at identity and TowerSpawn, the lights and the Watcher all hang off the same floor.

THE GUARD IS INSIDE IT NOW. A hollow chamber 10.2 m across with eight openings.

THE DECK IS AT THE GUARD'S EYE. Ryan: \"raise the top one to eye level.\" The eye is this floor plus 1.65 m = y=27.00, and the deck's walking surface is exactly there, so the guard looks flat along the whole ring."
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 25.35, 0)
script = ExtResource("8c_tower_variant")

[node name="Rock" parent="Tower" unique_id=1992333100 instance=ExtResource("8_tower_model")]
editor_description = "assets/models/tower.glb: the column, the drum and the hollow chamber, one mesh. It carries its OWN collision (a -colonly shape in the glTF), so the guard stands on the model's floor and is stopped by the model's stone -- there is no second, invisible copy of either in this scene, and nothing here can drift out of agreement with what you can see.

Its origin is the floor of the guard room, which is why it drops in at identity: see the Tower node above."
visible = false

[node name="RockArches" parent="Tower" unique_id=675330745 instance=ExtResource("8b_tower_arches")]
editor_description = "The Greek-arches variant; Tower.variant picks which one is live."

[node name="TowerSpawn" type="Marker3D" parent="Tower" unique_id=1882367771]
editor_description = "On the chamber floor, 0.25 m up. The clearance is deliberate: spawning a capsule with its feet exactly on the collision plane overlaps it, and depenetration launches the body across the arena. The model's origin IS this floor, so this is origin + 0.25 and nothing else."
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.95, 0)

[node name="KeyLight" type="DirectionalLight3D" parent="Tower" unique_id=788049124]
editor_description = "Fire from the hole above, angled 20 degrees off vertical (about 70 deg below horizontal) into the pit rather than the flat noon light of an office."
transform = Transform3D(1, 0, 0, 0, 0.34202, 0.939693, 0, -0.939693, 0.34202, 0, 20, 0)
light_color = Color(1, 0.45, 0.15, 1)
light_energy = 0.0
