[node name="OuterWall" type="CSGCombiner3D" parent="Ring"]
editor_description = "r=60.0 to r=62.0, from under level one up to y=35.0. It is the outer wall of all three galleries at once and what their decks stand on -- one solid doing the job three separate risers did when the levels were stepped. Jump apex on the tuned movement profile is 1.11 m, so no gallery can be left over it, and it is entirely outboard of every deck so it can never occlude the tower's view of ground."
use_collision = true

[node name="WallSolid" type="CSGCylinder3D" parent="Ring/OuterWall"]
radius = 62.0000
