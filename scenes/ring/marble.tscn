ambient_light_energy = 0.55
tonemap_mode = 1

[node name="Marble" type="Node3D"]
editor_description = "MAP 2, MARBLE: the Bentham drawing in white marble, one closed rotunda built on assets/models/marble.glb -- the lane annulus r 46.7..57.3 at y 23.0 (Map 1's ring) standing 1.6 m over two beds of marble spikes, the wall of cells (three tiers, 192 cells), a Greek-key frieze and a solid coffered dome to y 77.6. The model ships its own collision, so this scene adds no geometry: only the tower, the lethal volumes, the lights and the markers.

A prisoner runs one 340 deg lap at r 52 from 5 deg to the portal at 345 deg; the rock bars (a scene node, as on Map 1) close the lane at 353 deg between finish and start. Off the lane there is nothing to stand on: the inner bed is one KillVolume cylinder, the outer trough forty-eight TrapVolume boxes.

The light is the tower's: one shadowed warm-white omni in the lantern throws the eight windows' beams round the ring, over a cool grey ambient. No sun, no sky, no oculus."

[node name="Environment" type="Node3D" parent="."]

[node name="WorldEnvironment" type="WorldEnvironment" parent="Environment"]
environment = SubResource("Env")

[node name="MapBase" parent="." instance=ExtResource("10_map_model")]
editor_description = "assets/models/marble.glb: the whole rotunda, one contiguous mesh -- lane, both spike beds and their spikes, the trough, the wall of cells, the frieze, the dome. Ships its own collision (MarbleCollision-colonly); the spikes are not in it, the volumes below kill first."

[node name="KillBox" type="Area3D" parent="."]
editor_description = "The catch-all under the whole map, roof at y 12.0: nothing should ever reach it (the lowest floor is the bed's inner terrace at y 17.4), so a body here fell through the world. Trigger only, mask 1048577 (living bodies and ghosts); scripts/match/kill_volume.gd hands whatever entered to MatchController.handle_fall()."
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 20, 0)
collision_layer = 0
collision_mask = 1048577
monitorable = false
script = ExtResource("1_kill_volume")
radius_metres = 64.0
roof_depth_metres = 8.0
depth_metres = 30.0

[node name="Shape" type="CollisionShape3D" parent="KillBox"]
editor_description = "Deliberately empty. KillVolume._build_shape writes a CylinderShape3D over it on ready."

[node name="SpikeBed" type="Area3D" parent="."]
editor_description = "THE INNER BED OF SPIKES: one cylinder r 46.3 whose roof is at y 23.5, half a metre OVER the lane, reaching down past the lowest terrace (17.4). The radius is 0.4 m -- a capsule's -- inside the lane's lip at 46.7, so a body standing on the lane never touches it and a body whose feet have left the lip is dead before it lands; the spikes themselves are not colliders. The roof stands over the lane on purpose: RingBake carves a lethal volume out of the navigation mesh only across the heights it spans, so a roof under the lane would leave the bots a walkable mesh right to the edge. The guard's room (floor 27.05) and balcony (26.35) are above it."
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 31.5, 0)
collision_layer = 0
collision_mask = 1048577
monitorable = false
script = ExtResource("1_kill_volume")
radius_metres = 46.3
roof_depth_metres = 8.0
depth_metres = 14.0

[node name="Shape" type="CollisionShape3D" parent="SpikeBed"]

[node name="StartEnd" type="Node3D" parent="."]
editor_description = "One level, one lap: start at 5 deg and finish at 345 deg on the lane at y 23.0, the bars at 353 deg between them."

[node name="PrisonerStart" type="Marker3D" parent="StartEnd"]
editor_description = "5.0 deg on the lane, y 23.0: the model's lane surface exactly. Its ANGLE places the field -- MatchController deals bodies radially across the lane from here at start_line_spacing_metres -- and its height is load-bearing."
transform = Transform3D(-0.996195, 0, 0.0871557, 0, 1, 0, -0.0871557, 0, -0.996195, 51.8021, 23, 4.5321)

[node name="PrisonerEnd" type="Marker3D" parent="StartEnd"]
editor_description = "345.0 deg on the lane, matching the portal's own transform. The end of the whole route: reaching it takes the tower."
transform = Transform3D(0.965926, 0, 0.258819, 0, 1, 0, -0.258819, 0, 0.965926, 50.2281, 23, -13.4586)

[node name="Portal" parent="StartEnd" instance=ExtResource("19_portal")]
editor_description = "The finish at 345 deg. Local Z is the pass-through axis along the run, local X the span across the lane."
transform = Transform3D(0.965926, 0, 0.258819, 0, 1, 0, -0.258819, 0, 0.965926, 50.2281, 23, -13.4586)

[node name="RockBars" parent="." instance=ExtResource("20_rock_bars")]
editor_description = "Bars across the lane at 353 deg, in the gap between finish (345) and start (5), so the finish is visible from the start but not walkable back to: with a finish gate in the scene, standing in it is the win. The same scene node Map 1 uses, not a marble structure -- nothing is built on the lane. Local X (10.6 m) runs radially across the lane, local Z along it."
transform = Transform3D(0.992546, 0, 0.121869, 0, 1, 0, -0.121869, 0, 0.992546, 51.6124, 23, -6.33721)

[node name="Sections" type="Node3D" parent="."]
editor_description = "No sections on this map: Ryan, \"dont put anything on the ring, just get the tower and ring done\". Only the trough's lethal volumes and the guard's watch points live here."

[node name="Trough" type="Node3D" parent="Sections"]
editor_description = "THE OUTER BED OF SPIKES: the trough r 57.3..60.0 sunk 1.6 m under the lane, covered by 48 boxes of 7.5 deg, each 2.3 m radial (57.7..60.0, a capsule's radius outside the lip so a body on the lane never touches one) x 3.1 m tall (20.4..23.5, the top half a metre over the lane so RingBake carves the bots' mesh back from the edge) x 7.7 m along. Not feet_only: anything that overlaps one is dead, so the trough's teeth may stand higher than the lane. The inner chord corners (r 57.83) are within a capsule's radius of a body that has left the lip, so no body can stand on the trough floor uncovered."
