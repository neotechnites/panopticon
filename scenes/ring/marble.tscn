[node name="Watch" type="Node3D" parent="Sections"]
editor_description = "Chokepoints the AI guard's scan rests on. A plain lane has none, so these are the run's thirds: the opening straight, the far side, the approach to the finish."

[node name="Opening" type="Marker3D" parent="Sections/Watch" groups=["guard_watch"]]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 39.8343, 24, 33.425)

[node name="FarSide" type="Marker3D" parent="Sections/Watch" groups=["guard_watch"]]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -52, 24, 6.36816e-15)

[node name="Approach" type="Marker3D" parent="Sections/Watch" groups=["guard_watch"]]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 39.8343, 24, -33.425)

[node name="Route" type="Node3D" parent="."]
editor_description = "WHAT PROGRESS IS: the arc swept on the one lap, taken at the lane radius. Data, on the map; MatchLapTracker, RingRunner, the HUD and the round card read it from here."
script = ExtResource("5_ring_route")

[node name="Level1" type="Node3D" parent="Route"]
editor_description = "Level 1: lane y 23.0, r 46.7..57.3, lane r 52.0, 5 deg to 345 deg = 340 deg of lap, 309 m. Its exit is the finish of the whole route."
script = ExtResource("6_ring_level")
deck_height = 23.0
inner_radius = 46.7
outer_radius = 57.3
lane_radius = 52.0
entry_angle_degrees = 5.0
exit_angle_degrees = 345.0

[node name="Tower" type="Node3D" parent="."]
editor_description = "The tower, and its origin is the guard-room datum at y 25.35, exactly as Map 1: assets/models/marble_tower.glb puts its ROOM FLOOR 1.70 above this point (y 27.05), its foot 7.95 below it on the bed's lowest terrace (y 17.4), the eight windows on the 25 + 45k grid with sills at 27.7 and crowns at 32.35. The guard's eye at y 28.7 looks 6 deg down onto the lane at 52 m and sees every spike tip pass under that line.

TowerVariant's plugs still work here (same inner radius 6.86, same window grid). Both variant slots hold the same marble tower, so the rules' tower_variant never blanks it."
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 25.35, 0)
script = ExtResource("8c_tower_variant")

[node name="Rock" parent="Tower" instance=ExtResource("8_tower_model")]
editor_description = "assets/models/marble_tower.glb, the carved slot: the same marble tower, so a match run with tower_variant 0 has a tower."
visible = false

[node name="RockArches" parent="Tower" instance=ExtResource("8_tower_model")]
editor_description = "assets/models/marble_tower.glb: the live tower. Carries its own collision (MarbleTowerCollision-colonly): room floor, sill band, piers, window reveals, ceiling, balcony, parapet, shaft."

[node name="TowerSpawn" type="Marker3D" parent="Tower"]
editor_description = "On the room floor (1.70 over the origin), 0.25 m up so the capsule never starts inside the collision plane."
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.95, 0)

[node name="TowerLight" type="OmniLight3D" parent="Tower"]
editor_description = "THE ARENA'S LIGHT: one warm-white point in the lantern, shadowed, so the eight windows throw their beams across the ring as the drawing has them. Colour, energy, range, attenuation and height come from marble_tower_light_profile.tres; the light_* properties here are placeholders for the editor view."
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 8, 0)
light_color = Color(1, 0.98, 0.94, 1)
light_energy = 60.0
shadow_enabled = true
omni_range = 90.0
script = ExtResource("3_tower_light")
profile = ExtResource("4_tower_light_profile")
