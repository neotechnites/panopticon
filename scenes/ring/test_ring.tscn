[node name="Deck" type="CSGCombiner3D" parent="Ring"]
editor_description = "The running surface: a true annulus, outer r=60, inner r=35, 25 m wide. Lap length at mid-radius r=47.5 is 298 m -- 37 s at walk 8 m/s, 27 s at sprint 11 m/s, which is the length of one round."
use_collision = true

