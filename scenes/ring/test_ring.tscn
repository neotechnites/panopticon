[node name="WinZNA" type="CSGBox3D" parent="Tower/Room"]
editor_description = "Subtract: 4.0 x 2.5 m opening. The sill is at floor level (y=15) on purpose -- with a waist-high sill the outer bottom edge clips the look-down angle and the inner ~12 m of track becomes a permanent blind lane. Floor-level sills let a station at the window see all the way in to the kerb."
operation = 2
