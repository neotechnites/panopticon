[node name="OuterWall" type="CSGCombiner3D" parent="Ring"]
editor_description = "r=60 to r=62, 8 m tall. Jump apex on the tuned movement profile is 1.11 m, so 8 m is uncrossable by an order of magnitude; it sits entirely outboard of the deck so it can never occlude the tower's view of ground."
use_collision = true

