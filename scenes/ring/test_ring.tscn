[node name="InnerKerb" type="CSGCombiner3D" parent="Ring"]
editor_description = "Only 0.5 m tall on purpose. The inner boundary has to read as an edge without blocking sight: from the tower eye (y=16.7) the sightline to a 1.7 m target at r=37 is still 2.1 m up as it crosses r=36, so no height under ~2 m here can ever shadow the inner lane. Anything taller would hand runners a free covered lane for the whole lap."
use_collision = true

