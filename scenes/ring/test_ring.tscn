[node name="_CoreNote" type="Node3D" parent="Tower/Room"]
editor_description = "Documentation only, no geometry. The 12 x 12 m block left standing in the middle of Shell is the Core. It is what makes watching the whole ring at once impossible: from anywhere in the 4 m gallery it subtends >140 deg of whatever is directly opposite you."

[node name="FinNE" type="CSGBox3D" parent="Tower/Room"]
editor_description = "Diagonal pier off the Core corner, 1.0 x 3.5 m. Without it you can stand near a corner of the gallery and see out through two walls' windows at once. It stops 2.5 m short of the room corner so the gallery is still a loop you can walk -- sightline_probe.gd flood-fills the floor to prove it."
size = Vector3(1.0, 5.0, 3.5)
material = SubResource("MatStructure")
transform = Transform3D(0.70711, 0.0, 0.70711, 0.0, 1.0, 0.0, -0.70711, 0.0, 0.70711, 7.0, 17.0, 7.0)

