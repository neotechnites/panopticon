[node name="TestRing" type="Node3D"]
editor_description = "PANOPTICON greybox arena. 0.5 m grid throughout. Deck r35-r60 (25 m track), outer wall +8 m, open shooter platform r=8 at the centre with its surface level with the deck at y=0. Runners go counter-clockwise from PrisonerStart (+5 deg) all the way round to PrisonerEnd (-5 deg), 8 m apart across LapDivider."

[node name="Environment" type="Node3D" parent="."]

[node name="WorldEnvironment" type="WorldEnvironment" parent="Environment"]
environment = SubResource("Env")

