[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/net/net_session.gd" id="1_session"]
[ext_resource type="Script" path="res://scripts/net/enet_transport.gd" id="2_enet"]

[node name="NetSession" type="Node" node_paths=PackedStringArray("transport")]
editor_description = "The session, with the development backend fitted. Drop one of these into a scene that needs networking and call host() or join() on it. Swapping to a Steam backend when one exists is replacing the child node and repointing 'transport' -- nothing above this scene names a transport type. Note that RPCs resolve by node path, so this node must sit at the same path on every peer."
script = ExtResource("1_session")
transport = NodePath("ENetTransport")

[node name="ENetTransport" type="Node" parent="."]
editor_description = "Raw UDP. Runs with no Steam client present at all, which is what the headless bot harness and CI depend on."
script = ExtResource("2_enet")
