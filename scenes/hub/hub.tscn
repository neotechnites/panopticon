[node name="Player" parent="." instance=ExtResource("7_player")]
editor_description = "The local body. In the hub it is a prisoner with nothing to run: full movement, a harmless shove, no rifle and no powers."

[node name="Runners" type="Node3D" parent="."]
editor_description = "Empty by design. NetMatch parents one body per OTHER seated human into it; a hub never holds a bot."

[node name="NetMatch" type="Node" parent="." node_paths=PackedStringArray("controller", "player", "runner_container")]
editor_description = "The seat table's bodies and their links, in hub mode: no match events, no ready handshake, and a rebuild when somebody joins or leaves. Idle in an offline hub."
script = ExtResource("10_net_match")
hub_mode = true
controller = NodePath("../MatchController")
player = NodePath("../Player")
runner_container = NodePath("../Runners")
runner_scene = ExtResource("8_runner")

[node name="MatchController" type="Node" parent="." node_paths=PackedStringArray("arena", "player", "runner_container")]
editor_description = "In hub_mode: it places the bodies, wakes them and ticks the shove, and arms no race, no round and no tower. rifle is deliberately unset -- there is no gun in the lobby."
script = ExtResource("9_controller")
hub_mode = true
rules = ExtResource("19_rules")
palette = ExtResource("20_palette")
arena = NodePath("../HubWorld")
player = NodePath("../Player")
runner_container = NodePath("../Runners")
