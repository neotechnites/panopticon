[node name="Beach" type="Node3D"]
editor_description = "The beach: a bay between two jetties, the island behind a low rock wall, a yacht for the tower. Notes in docs/maps/beach.md."

[node name="Environment" type="Node3D" parent="."]

[node name="WorldEnvironment" type="WorldEnvironment" parent="Environment"]
environment = SubResource("Env")

[node name="Sun" type="DirectionalLight3D" parent="Environment"]
editor_description = "The sun the sky draws: bearing 15 over the sea, 35 deg up."
transform = Transform3D(0.2588, -0.554, 0.7913, 0, 0.8192, 0.5736, -0.9659, -0.1484, 0.212, 0, 80, 0)
light_color = Color(1, 1, 0.97, 1)
light_energy = 0.185
shadow_enabled = true
shadow_bias = 0.06
shadow_blur = 1.5
directional_shadow_mode = 0
directional_shadow_max_distance = 200.0

[node name="SunDisc" type="MeshInstance3D" parent="Environment"]
editor_description = "The sun sprite: core, halo and star rays, 2.5 km out toward the Sun, square to the camera (beach_sun.gdshader)."
cast_shadow = 0
custom_aabb = AABB(-8192, -8192, -8192, 16384, 16384, 16384)
mesh = SubResource("SunQuad")
surface_material_override/0 = SubResource("SunMat")

[node name="SunGlare" type="MeshInstance3D" parent="Environment"]
editor_description = "The blinding wash and rays when looking at the sun, cut when it is hidden (beach_sun_glare.gdshader)."
