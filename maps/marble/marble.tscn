[node name="Route" type="Node3D" parent="."]
editor_description = "WHAT PROGRESS IS: the arc swept on the one lap, taken at the lane radius. Data, on the map; MatchLapTracker, RingRunner, the HUD and the round card read it from here."
script = ExtResource("5_ring_route")

[node name="Level1" type="Node3D" parent="Route"]
editor_description = "Level 1: the gallery walkway at y 23.0, r 46.7..59.5 (the slab itself runs to 59.55; the route stops a hair short of the cell wall), lane r 52.0, 5 deg to 345 deg = 340 deg of lap, 309 m. Its exit is the finish of the whole route."
script = ExtResource("6_ring_level")
deck_height = 23.0
inner_radius = 46.7
outer_radius = 59.5
lane_radius = 52.0
entry_angle_degrees = 5.0
exit_angle_degrees = 345.0

[node name="Tower" type="Node3D" parent="."]
editor_description = "The tower, and its origin is the guard-room datum at y 25.35, exactly as Map 1: maps/marble/models/marble_tower.glb puts its ROOM FLOOR 1.70 above this point (y 27.05) and its foot 26.35 below it on the spiked ground floor (y -1.0): one round shaft of constant diameter (r 7.0) rising through the drop. At the room floor the shaft opens into a colonnade of sixteen thin columns at bearings 25 + 22.5k under a dome; the guard's eye at y 29.3 (a 0.6 m dais under the seat) looks out between them 7 deg down onto the walkway at 52 m. Round the shaft at the room floor's own level, one flat floor through the columns, a 1.2 m balcony ledge with a 1.0 m railing (rail top 28.05, under the guard's sight line to the lane from the dais) -- the railing is a collider, nobody walks off.

TowerVariant's plugs still work here (same inner radius 6.86, same 25 + 45k grid): each 43 deg plug closes the two openings either side of its column. Both variant slots hold the same marble tower, so the rules' tower_variant never blanks it."
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 25.35, 0)
script = ExtResource("8c_tower_variant")

[node name="Rock" parent="Tower" instance=ExtResource("8_tower_model")]
editor_description = "maps/marble/models/marble_tower.glb, the carved slot: the same marble tower, so a match run with tower_variant 0 has a tower."
visible = false

[node name="RockArches" parent="Tower" instance=ExtResource("8_tower_model")]
editor_description = "maps/marble/models/marble_tower.glb: the live tower. Carries its own collision (MarbleTowerCollision-colonly): foot, steps, shaft, balcony slab and ledge, an invisible band in the railing's place, room floor, columns, ring beam closed with a flat ceiling."

[node name="TowerSpawn" type="Marker3D" parent="Tower"]
editor_description = "On the room floor's centre (1.70 over the origin), 0.25 m up so the capsule never starts inside the collision plane."
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.95, 0)

[node name="Elements" type="Node3D" parent="."]
editor_description = "Placed lane elements: six curved walls on the lip at Ryan's six bearings, and the four sections as a grey blockout (tools/modelling/maps/marble/marble_sections_blockout.py writes them): A trapdoors under cover 70-118 deg, B wall with activators on top 259-295, C buttresses 197-242, D column forest 16-57."

[node name="ArcWall003" parent="Elements" instance=ExtResource("25_wall_arc_long")]
editor_description = "A curved ashlar wall on the lip at 3.6 deg (clear of the bars at 353), r 47.3, 16.3 m along the lane, 7.6 m tall: cover from the tower."
transform = Transform3D(0.998027, 0, -0.062791, 0, 1, 0, 0.062791, 0, 0.998027, 47.2067, 23.0, 2.9700)

