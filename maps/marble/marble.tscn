[node name="Beam" type="Node3D" parent="Oculus"]
editor_description = "Six crossed vanes from the oculus glass (r 11, y 78.5) to just over the tower top (y 40), fanned at the spot's 62 deg (half-width 11 m at the top, 83 m at the foot, cut off by the walls from y 53 down), shaded with the spot's own angular falloff times a 28 deg core and a quarter-strength skirt, feathered toward the foot."

