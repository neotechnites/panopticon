[node name="NoSun" type="DirectionalLight3D" parent="Environment"]
editor_description = "Energy 0: its presence stops the editor's preview sun so the editor matches the game."
light_energy = 0.0
shadow_enabled = false

[node name="Sun" type="DirectionalLight3D" parent="Environment"]
editor_description = "Daylight from bearing 140, 50 deg up: the one shadowed light."
