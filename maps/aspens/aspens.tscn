[node name="Aspens" type="Node3D"]
editor_description = "Map 6, first pass: a grove of fall aspens on open ground, a stump for the tower, open sky. One sculpt in 14 chunks at identity. Notes in docs/maps/aspens.md."

[node name="Environment" type="Node3D" parent="."]

