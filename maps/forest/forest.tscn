[node name="Bars" parent="." unique_id=669641580 instance=ExtResource("9_forest_bars")]
editor_description = "The barrier across the lane at 353 deg, in the gap between the finish (345) and the start (5), so the finish is visible from the start but not walkable back to. The same node and the same place Map 1 and Map 2 give their bars, in the forest's own terms: maps/forest/models/forest_bars.glb, a stand of saplings and young trunks grown up out of the ground, no frame and no carpentry. It keeps rock_bars.glb's envelope (10.6 x 8.5 m, origin the base centre) and its guarantee that no gap anywhere exceeds 0.38 m, so the swap is the model and nothing else. Local X (10.6 m) runs radially across the lane, local Z along it. Its collider is ForestBarsCollision/ForestBarsCollisionShape: one BoxShape3D, 10.6 x 8.5 x 1.2 m, the only collision shape under this node."
transform = Transform3D(0.992546, 0, 0.121869, 0, 1, 0, -0.121869, 0, 0.992546, 51.6124, 23, -6.33721)

