[node name="Tower" type="Node3D" parent="." unique_id=1427859619]
editor_description = "The tree. Origin y 25.35 as map 1's tower; the guard's floor is the platform at the top of the trunk, +1.70 (y 27.05), eye y 28.7, under the arches and the leaf canopy."
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 25.35, 0)

[node name="Tree" parent="Tower" unique_id=472629347 instance=ExtResource("7_forest_tree")]
editor_description = "maps/forest/models/forest_tree.glb: goblet trunk, the platform, eight piers and pointed arches (the windows), the vaulted canopy over it, and the crown grown outward as the sagging middle of the level's roof -- from the rim at r 11, y 34.1 it sweeps UP and OUT 15.9 m to the seam ring at r 47.6, y 50.0, shared vertex for vertex with forest.glb's cell drum, eight great limbs rising under it. Ships its own collision (ForestTreeCollision-colonly), the canopy sheet included."

[node name="ForestTree" parent="Tower/Tree" index="0" unique_id=1057893921]
editor_description = "Casts no shadow itself; Tower/TreeShadow casts it: solid only under the roof over the guard, broken through every leaf."
