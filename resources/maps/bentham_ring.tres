[gd_resource type="Resource" script_class="MapDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/maps/map_definition.gd" id="1_map_definition"]

[resource]
script = ExtResource("1_map_definition")
id = &"bentham_ring"
title = "The Bentham Ring"
summary = "The original ring. A 25-metre deck circling the tower, cover in three bands, four pits cut clean through the floor and six kill blocks set flush against the lanes. One start line, one finish, and the eye in the middle can see all of it."
scene_path = "res://scenes/ring/bentham_ring.tscn"
