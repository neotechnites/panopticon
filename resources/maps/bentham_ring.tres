[gd_resource type="Resource" script_class="MapDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/maps/map_definition.gd" id="1_map_definition"]

[resource]
script = ExtResource("1_map_definition")
id = &"bentham_ring"
title = "The Bentham Ring"
summary = "Three decks stacked outward and upward around the tower, and you have to lap all three. Cover in bands on every level, twelve pits cut clean through the floors, kill blocks flush against every lane, and one ramp up off each level, behind cover. The eye in the middle now stands above all of it and can see every deck."
scene_path = "res://scenes/ring/bentham_ring.tscn"
