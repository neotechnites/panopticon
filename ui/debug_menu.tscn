[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/debug_menu.gd" id="1_debug_menu"]
[ext_resource type="PackedScene" path="res://ui/settings_screen.tscn" id="2_settings_screen"]

[node name="DebugMenu" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
editor_description = "Every developer tool, out of the player's menus; scripts/ui/debug_menu.gd wires it."
script = ExtResource("1_debug_menu")

[node name="Frame" type="MarginContainer" parent="."]
